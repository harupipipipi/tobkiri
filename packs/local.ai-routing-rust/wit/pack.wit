package local:ai-routing@1.0.0;

interface routing {
  use tobkiri:core/types@1.2.0.{error};

  /// Route over supplied model and provider descriptors, health and decision time.
  /// An empty result leaves evaluation to the original router.
  evaluate: func(request: string) -> result<string, error>;
}

interface stream-result {
  use tobkiri:core/types@1.2.0.{error};

  /// Project the supplied Gateway stream events in ordered finite JSON.
  /// An empty result leaves normalization to the original stream provider.
  normalize: func(request: string) -> result<string, error>;
}

interface usage-cost {
  use tobkiri:core/types@1.2.0.{error};

  /// Project cost from the supplied usage and rates in ordered finite JSON.
  /// An empty result leaves calculation to the original usage provider.
  calculate: func(request: string) -> result<string, error>;
}

interface tool-intents {
  use tobkiri:core/types@1.2.0.{error};

  /// Project Gateway tool intents as non-authoritative operation descriptors.
  /// An empty result leaves normalization to the original tool bridge provider.
  normalize: func(request: string) -> result<string, error>;
}

world pack {
  import tobkiri:core/types@1.2.0;
  export tobkiri:core/lifecycle@1.2.0;
  export routing;
  export stream-result;
  export usage-cost;
  export tool-intents;
}
