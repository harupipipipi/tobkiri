package local:saved-conversation@1.0.0;

interface data {
  /// Original conversation owner document retained in private DATA.
  type owner-document = string;
}

interface model {
  use tobkiri:core/types@1.2.0.{error};

  /// Read the conversation's stored model at the exact expected revision.
  select: func(conversation-id: string, conversation-revision: u64) -> result<string, error>;
}

interface legacy-read {
  use tobkiri:core/types@1.2.0.{json, error};

  /// Read one complete conversation from the authenticated Profile's physical
  /// owner document. None represents an absent file.
  /// The original owner reply is enclosed as the owner-result JSON string.
  get: func(document: option<string>, conversation-id: string) -> result<json, error>;
}

interface legacy-list {
  use tobkiri:core/types@1.2.0.{json, error};

  /// Return the complete snapshot of the authenticated Profile's owner document.
  /// None represents an absent file. The snapshot is the owner-result JSON string.
  %list: func(document: option<string>) -> result<json, error>;
}

interface legacy-linked-context {
  use tobkiri:core/types@1.2.0.{json, error};

  /// Read a conversation and its inherited context from one snapshot of the
  /// authenticated Profile. The parent owner reply is private Host data for
  /// its separately authorized read.
  get: func(document: option<string>, conversation-id: string) -> result<json, error>;
}

interface legacy-receipt {
  use tobkiri:core/types@1.2.0.{json, error};

  /// Read the saved append receipt from the authenticated Profile's owner
  /// document. None represents an absent file. The original owner reply is
  /// enclosed as the owner-result JSON string.
  get: func(document: option<string>, turn-id: string) -> result<json, error>;
}

interface legacy-confirmation {
  use tobkiri:core/types@1.2.0.{json, error};

  /// Evaluate the locked owner document with a Host-read terminal Turn.
  /// Return the owner-result JSON string and an optional replacement document.
  /// The guest has no authority to publish the replacement.
  confirm: func(document: string, turn: string) -> result<json, error>;
}

interface legacy-append {
  use tobkiri:core/types@1.2.0.{json, error};

  /// Plan an append, receipt and lifecycle update from one locked owner document.
  /// Only the native host can publish the proposed replacement.
  append: func(document: string, request: string) -> result<json, error>;
}

world pack {
  include tobkiri:core/pack-minimal@1.2.0;
  import tobkiri:core/storage@1.2.0;
  export model;
  export legacy-read;
  export legacy-linked-context;
  export legacy-receipt;
  export legacy-confirmation;
  import tobkiri:core/clock@1.2.0;
  export legacy-append;
  export legacy-list;
}
