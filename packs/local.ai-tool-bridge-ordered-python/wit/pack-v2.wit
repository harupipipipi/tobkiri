package local:ai-tool-bridge-ordered-python@2.0.0;

/// Pack-owned ordered-finite-json-v2, not CoreStrictV1 json.
interface bridge {
  use tobkiri:core/types@1.0.0.{error};
  runtime-info: func() -> string;
  normalize: func(operation: string, payload: string) -> result<string, error>;
}
world pack {
  include tobkiri:core/pack-minimal@1.0.0;
  export bridge;
}
