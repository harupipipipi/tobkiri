package local:provider-registry@1.0.0;

interface data {
  type registry-document = string;
}

interface %resource {
  use tobkiri:core/types@1.2.0.{json, error};

  /// Read the current Profile's UI-safe provider connections.
  snapshot: func(payload: json) -> result<json, error>;
}

interface legacy-resource {
  use tobkiri:core/types@1.2.0.{error, json};

  /// Snapshot the active Profile's original Registry document supplied by Core.
  /// Apply the redacted settings projection only when requested.
  snapshot: func(document: option<string>, settings-projection: bool) -> result<json, error>;
}

interface manage {
  use tobkiri:core/types@1.2.0.{json, error};

  /// Internal adapter operation: apply save, model_access.save, or delete
  /// with an expected revision. Result records are for the adapter only.
  apply: func(payload: json) -> result<json, error>;
}

interface routing {
  use tobkiri:core/types@1.2.0.{json, error};

  /// Resolve an enabled keyless loopback connection in the current Profile.
  resolve-local: func(provider: string) -> result<json, error>;
}

interface configuration {
  use tobkiri:core/types@1.2.0.{json, error};

  /// Local connection proposal. The provider kind is fixed and no key is accepted.
  record local-connection {
    connection-name: string,
    endpoint: string,
    catalog-provider-id: option<string>,
    display-name: option<string>,
    capabilities: option<list<string>>,
  }

  /// Prepare against the current Profile's private Registry without writing it.
  prepare-local: func(request: local-connection) -> result<json, error>;
}

interface configuration-commit {
  use configuration.{local-connection};
  use tobkiri:core/types@1.2.0.{json, error};

  /// This operation requires a separate grant. The digest binds the
  /// canonical base plan returned by prepare-local.
  execute-local: func(request: local-connection, plan-digest: string) -> result<json, error>;
}

interface legacy-configuration {
  use configuration.{local-connection};
  use tobkiri:core/types@1.2.0.{json, error};

  /// Read-only planning from the two observations of the old Profile Registry.
  /// The native caller owns acquisition and provenance. This interface writes
  /// neither Registry and does not authorize a save.
  prepare-local: func(request: local-connection, snapshot: option<string>,
                      preflight: option<string>) -> result<json, error>;
}

interface legacy-configuration-live {
  use configuration.{local-connection};
  use tobkiri:core/types@1.2.0.{callback-handle, json, error};

  /// Read each observation when the planner reaches it. The native caller
  /// binds the callback to the active Profile's old Registry.
  prepare-local: func(request: local-connection, observe: callback-handle) -> result<json, error>;
}

interface legacy-configuration-commit {
  use configuration.{local-connection};
  use tobkiri:core/types@1.2.0.{callback-handle, json, error};

  /// Revalidate the approved base plan using live Registry observations.
  /// Return the prepared record and expected revision for the original saver.
  validate-local: func(request: local-connection, plan: json, observe: callback-handle) -> result<json, error>;
}

interface legacy-configuration-apply {
  use configuration.{local-connection};
  use tobkiri:core/types@1.2.0.{callback-handle, json, error};

  /// Stage the complete original Registry document without persisting it.
  /// Read with JSON null four times on success, then ask for Unix seconds
  /// with the JSON string "clock". The native caller owns the final read lock.
  stage-local: func(request: local-connection, plan: json, observe: callback-handle) -> result<json, error>;
}

world pack {
  include tobkiri:core/pack-minimal@1.2.0;
  import tobkiri:core/storage@1.2.0;
  export %resource;
  export legacy-resource;
  export manage;
  export routing;
  export configuration;
  export configuration-commit;
  export legacy-configuration;
  export legacy-configuration-live;
  export legacy-configuration-commit;
  export legacy-configuration-apply;
}
