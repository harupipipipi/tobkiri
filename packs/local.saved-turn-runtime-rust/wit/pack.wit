package local:saved-turn-runtime@1.0.0;

interface legacy-settlement {
  use tobkiri:core/types@1.2.0.{error};

  enum settlement-error {
    invalid-request,
    not-found,
    invalid-record,
    invalid-reference,
    conflict,
    requires-legacy-codec,
    capacity,
    revoked,
    storage,
    commit-unconfirmed,
  }

  record replacement {
    updated-at: s64,
    /// Original Turn owner JSON, at most 1 MiB UTF-8.
    body: string,
  }

  variant settlement-outcome {
    replay,
    update(replacement),
    rejected(settlement-error),
  }

  /// Prepare the receipt decision for one indexed row in Core's live Profile.
  /// The infrastructure owner applies any replacement under its existing transaction.
  prepare: func(
    turn-id: string,
    request-id: string,
    body: string,
    input-digest: string,
    expected-revision: option<u64>,
    result-reference: string,
  ) -> result<settlement-outcome, error>;
}

interface legacy-read {
  use tobkiri:core/types@1.2.0.{error};

  enum read-outcome {
    valid,
    invalid-record,
    requires-legacy-codec,
    capacity,
  }

  /// Verify the row in Core's live Profile without returning a second copy.
  validate: func(turn-id: string, request-id: string, body: string) -> result<read-outcome, error>;
}

interface legacy-start {
  use tobkiri:core/types@1.2.0.{error};
  use legacy-settlement.{settlement-outcome};

  /// Prepare the original queued record for the current Core Profile.
  begin: func(
    turn-id: string,
    conversation-id: string,
    conversation-revision: u64,
    input-digest: string,
  ) -> result<settlement-outcome, error>;

  /// Prepare a claim for a validated row observed under the Turn owner's lock.
  claim: func(
    turn-id: string,
    request-id: string,
    body: string,
    conversation-id: string,
    conversation-revision: u64,
    input-digest: string,
  ) -> result<settlement-outcome, error>;
}

world pack {
  import tobkiri:core/types@1.2.0;
  import tobkiri:core/flow@1.2.0;
  import tobkiri:core/clock@1.2.0;
  export tobkiri:core/lifecycle@1.2.0;
  export legacy-settlement;
  export legacy-read;
  export legacy-start;
}
