{
  "format": "tobkiri.flow/1",
  "id": "turn",
  "implements": "local.echo-chat.turn-flow@1.0",
  "loop_limits": "profile-default",
  "on_error": {
    "default": "fail",
    "steps": {}
  },
  "steps": [
    {
      "call": {
        "args": {
          "conversation": "$input.conversation"
        },
        "op": "load",
        "shape": "local.echo-chat.conversation-store@1.0"
      },
      "id": "load",
      "out": "ctx",
      "overlay": "open",
      "role": "local.echo-chat.load-context@1.0"
    },
    {
      "call": {
        "args": {
          "ctx": "$ctx",
          "input": "$input"
        },
        "op": "build",
        "shape": "local.echo-chat.prompt-builder@1.0"
      },
      "id": "prompt",
      "out": "prompt",
      "overlay": "open",
      "role": "local.echo-chat.assemble-prompt@1.0"
    },
    {
      "call": {
        "args": {
          "prompt": "$prompt"
        },
        "op": "chat",
        "shape": "local.echo-chat.llm-provider@1.0"
      },
      "id": "generate",
      "overlay": "open",
      "role": "local.echo-chat.generate@1.0",
      "stream": {
        "collect": "turn",
        "emit": "local.echo-chat.assistant-output@1.0"
      }
    },
    {
      "call": {
        "args": {
          "conversation": "$input.conversation",
          "events": "$turn",
          "input": "$input"
        },
        "op": "append",
        "shape": "local.echo-chat.conversation-store@1.0"
      },
      "id": "save"
    }
  ],
  "trigger": {
    "input": "local.echo-chat.user-input@1.0"
  }
}
