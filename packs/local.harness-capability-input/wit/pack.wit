package local:harness-capability-input@1.0.0;

interface requests {
  use tobkiri:core/types@1.0.0.{json, error, stream-handle};
  type flow-frame = json;
  submit: func(payload: string) -> result<stream-handle, error>;
}

interface projection-flow {
  run: func();
}

world pack {
  include tobkiri:core/pack-minimal@1.0.0;
  export requests;
}
