package local:ai-stream-normalizer-python@1.0.0;

/// Original event projection and terminal validation; no synthetic terminal.
/// Payload and successful result are opaque ordered-finite-json-v2 DATA.
interface stream-normalizer {
  use tobkiri:core/types@1.0.0.{error};
  runtime-info: func() -> string;
  normalize: func(operation: string, payload: string) -> result<string, error>;
}
world pack {
  include tobkiri:core/pack-minimal@1.0.0;
  export stream-normalizer;
}
