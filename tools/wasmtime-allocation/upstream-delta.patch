+        let before = unconfirmed_cleanup_count();
+        let failure = match MmapFiberStack::new_with(
+            4096,
+            |_, _| Err(format_err!("injected mprotect failure")),
+            |_, _| Err(format_err!("injected munmap failure")),
+        ) {
+            Err(error) => error,
+            Ok(_) => panic!("injected protect unexpectedly succeeded"),
+        };
+        assert!(unconfirmed_cleanup_count() >= before + 1);
+        let mapping = failure
+            .unreleased
+            .expect("unconfirmed mapping must stay owned");
+        assert!(mapping.range().is_some());
+        // Explicit successful cleanup, not a timeout or destructor assumption.
+        assert!(mapping.try_release().is_ok());
+    }
