+// On-demand native stacks physically unmap on drop. Metadata is inline; custom
+// and pooling allocators are rejected before entering this supported path.
+pub(crate) struct FundedFiberStack {
+    stack: ManuallyDrop<FiberStack>,
+    lease: ManuallyDrop<HostAllocationLease>,
+}
+
+impl FundedFiberStack {
+    pub(crate) fn new(stack: FiberStack, lease: HostAllocationLease) -> Self {
+        Self {
+            stack: ManuallyDrop::new(stack),
+            lease: ManuallyDrop::new(lease),
+        }
+    }
+    fn into_parts(mut self) -> (FiberStack, HostAllocationLease) {
+        let stack = unsafe { ManuallyDrop::take(&mut self.stack) };
+        let lease = unsafe { ManuallyDrop::take(&mut self.lease) };
+        mem::forget(self);
+        (stack, lease)
+    }
+}
+impl Drop for FundedFiberStack {
+    fn drop(&mut self) {
+        let stack = unsafe { ManuallyDrop::take(&mut self.stack) };
+        #[cfg(unix)]
+        match stack.try_release() {
+            Ok(()) => drop(unsafe { ManuallyDrop::take(&mut self.lease) }),
+            Err((_error, unreleased)) => {
+                // No destructor/timeout can turn uncertain cleanup into credit.
+                // The adapter remains strongly held and its OS owner lock and
+                // stable-account charge stay occupied until process cleanup.
+                mem::forget(unreleased);
+            }
+        }
+        #[cfg(not(unix))]
+        {
+            mem::forget(stack);
+        }
+    }
+}
