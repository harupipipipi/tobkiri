+// Inline iterator replaces upstream's boxed dynamic result iterators. Its
+// control metadata is stack-resident, not an uncharged host heap temporary.
+enum LiftResultSource<'a> {
+    Flat(core::slice::Iter<'a, ValRaw>),
+    Memory { bytes: &'a [u8], offset: usize },
+}
+pub(crate) struct LiftResults<'a, 'b> {
+    cx: &'a mut LiftContext<'b>,
+    types: &'b [InterfaceType],
+    index: usize,
+    source: LiftResultSource<'a>,
+}
+impl Iterator for LiftResults<'_, '_> {
+    type Item = Result<Val>;
+    fn next(&mut self) -> Option<Self::Item> {
+        let ty = *self.types.get(self.index)?;
+        self.index += 1;
+        Some(match &mut self.source {
+            LiftResultSource::Flat(src) => Val::lift(self.cx, ty, src),
+            LiftResultSource::Memory { bytes, offset } => {
+                let abi = self.cx.types.canonical_abi(&ty);
+                let at = abi.next_field32_size(offset);
+                Val::load(self.cx, ty, &bytes[at..][..abi.size32 as usize])
+            }
+        })
+    }
