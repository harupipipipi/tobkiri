{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "authority-approval-context",
  "description": "One-shot approval provenance and close access for the focused dedicated approval window",
  "local": false,
  "windows": ["authority-approval"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "allow-authority-approval-context",
    "allow-close-current-window"
  ]
}
