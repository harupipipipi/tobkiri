{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "native-first-setup",
  "description": "Allows the main Tobkiri Setup panel to read the Launcher route and request an isolated review.",
  "local": false,
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/panel/setup", "http://localhost:*/panel/setup"]
  },
  "permissions": ["allow-native-setup-route", "allow-start-native-setup-review"]
}
