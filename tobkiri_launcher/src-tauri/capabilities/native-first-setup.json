{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "native-first-setup",
  "description": "Allows the main loopback panel to request the Setup review. Launcher verifies the exact live Setup URL.",
  "local": false,
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*"]
  },
  "permissions": ["allow-native-setup-route", "allow-start-native-setup-review"]
}
