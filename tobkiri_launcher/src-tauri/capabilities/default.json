{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "defaultspack-main", "authority-approval", "ambient-trigger", "finger-recording", "defaults-console", "host-permissions"],
  "remote": {
    "urls": [
      "http://127.0.0.1:8765/*",
      "http://localhost:8765/*",
      "http://127.0.0.1:8766/*",
      "http://localhost:8766/*"
    ]
  },
  "permissions": ["core:default"]
}
