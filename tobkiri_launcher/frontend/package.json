{
  "name": "tobkiri-launcher-frontend",
  "private": true,
  "version": "1.0.0-beta.3",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/measure-build.mjs && node scripts/copy-panel-build.mjs",
    "prebuild": "npm run generate:contract-map:check && npm run generate:defaults-setup-contract:check",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "prelint": "npm run generate:contract-map:check && npm run generate:defaults-setup-contract:check",
    "generate:contract-map": "node scripts/generate-frontend-contract-map.mjs",
    "generate:contract-map:check": "node scripts/generate-frontend-contract-map.mjs --check",
    "generate:defaults-setup-contract": "node scripts/generate-defaults-setup-contract.mjs",
    "generate:defaults-setup-contract:check": "node scripts/generate-defaults-setup-contract.mjs --check",
    "measure:build": "node scripts/measure-build.mjs",
    "pretest": "npm run generate:contract-map:check && npm run generate:defaults-setup-contract:check",
    "audit": "node scripts/audit.mjs",
    "test": "node --test-concurrency=1 --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"scripts/**/*.test.mjs\"",
    "tauri": "cd .. && npm exec --prefix frontend -- tauri"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/api": "2.10.1",
    "@uiw/react-codemirror": "^4.25.8",
    "@vitejs/plugin-react": "^6.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "8.3.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^8.0.16",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^8.0.16"
  }
}
