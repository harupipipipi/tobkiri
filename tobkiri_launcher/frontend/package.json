{
  "name": "tobkiri-launcher-frontend",
  "private": true,
  "version": "1.0.0-beta.2",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/measure-build.mjs && node scripts/copy-panel-build.mjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "measure:build": "node scripts/measure-build.mjs",
    "audit": "npm audit --audit-level=high",
    "test": "node --import tsx --test src/components/layout/*.test.tsx src/components/ui/*.test.tsx src/lib/*.test.ts src/pages/*.test.tsx scripts/*.test.mjs",
    "tauri": "cd .. && npm exec --prefix frontend -- tauri"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/api": "2.10.1",
    "@uiw/react-codemirror": "^4.25.8",
    "@vitejs/plugin-react": "^6.0.2",
    "@xyflow/react": "^12.10.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "8.3.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^8.0.16",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^8.0.16"
  }
}
