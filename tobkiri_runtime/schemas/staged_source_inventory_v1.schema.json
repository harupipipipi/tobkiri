{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io.tobkiri.staged-source-inventory.v1",
  "title": "Preserved non-admitted Tobkiri Source inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "io.tobkiri.staged-source-inventory.v1"
    },
    "records": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_root",
          "state",
          "runtime_authority",
          "installed_claim",
          "profile_selection",
          "files"
        ],
        "properties": {
          "source_id": {
            "enum": [
              "tobkiri_surface_renderer_pack",
              "tobkiri_voice_agent_pack"
            ]
          },
          "source_root": {
            "enum": [
              "ecosystem/tobkiri_surface_renderer_pack",
              "ecosystem/tobkiri_voice_agent_pack"
            ]
          },
          "state": {
            "const": "staged_unadmitted"
          },
          "runtime_authority": {
            "type": "boolean",
            "const": false
          },
          "installed_claim": {
            "type": "boolean",
            "const": false
          },
          "profile_selection": {
            "type": "boolean",
            "const": false
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
