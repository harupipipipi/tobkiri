{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rumi.local/rumi.ui.contribution.v1.json",
  "title": "Tobkiri frontend contribution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "kind",
    "mode",
    "label",
    "priority",
    "accessibility"
  ],
  "properties": {
    "version": {"const": "rumi.ui.contribution.v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"},
    "kind": {
      "enum": [
        "route",
        "renderer",
        "shell_region",
        "action",
        "data_source",
        "settings",
        "command",
        "ai_strategy",
        "view"
      ]
    },
    "mode": {"enum": ["declarative", "isolated", "same_origin_builtin"]},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "priority": {"type": "integer"},
    "route": {"type": "string", "pattern": "^/[a-zA-Z0-9/_-]*$"},
    "region": {"type": "string"},
    "renderer": {"type": "string"},
    "schema": {"type": "object"},
    "view": {"type": "object"},
    "action_contract": {
      "type": "string",
      "pattern": "^rumi\\.action\\.[a-z0-9]+(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"
    },
    "data_source_contract": {
      "type": "string",
      "pattern": "^rumi\\.resource\\.[a-z0-9]+(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"
    },
    "strategy_reference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 256},
        "description": {"type": "string", "maxLength": 1024},
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "uniqueItems": true,
          "maxItems": 8
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "export", "content_hash"],
      "properties": {
        "path": {"type": "string", "pattern": "^/static/packs/[a-zA-Z0-9._/-]+\\.js$"},
        "export": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "isolated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rpc_contracts"],
      "properties": {
        "path": {"type": "string", "pattern": "^/isolated/packs/[a-zA-Z0-9._/-]+$"},
        "rpc_contracts": {
          "type": "array",
          "items": {"type": "string", "pattern": "^rumi\\.(action|resource)\\."},
          "uniqueItems": true
        }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "keyboard"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "keyboard": {"type": "boolean"},
        "live": {"enum": ["off", "polite", "assertive"]}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "allOf": [
          {"properties": {"mode": {"const": "declarative"}}},
          {"properties": {"kind": {"not": {"const": "ai_strategy"}}}}
        ]
      },
      "then": {"required": ["view"]}
    },
    {
      "if": {"properties": {"mode": {"const": "isolated"}}},
      "then": {"required": ["isolated"]}
    },
    {
      "if": {"properties": {"mode": {"const": "same_origin_builtin"}}},
      "then": {"required": ["module"]}
    },
    {
      "if": {"properties": {"kind": {"const": "route"}}},
      "then": {"required": ["route"]}
    },
    {
      "if": {"properties": {"kind": {"const": "renderer"}}},
      "then": {"required": ["renderer"]}
    },
    {
      "if": {"properties": {"kind": {"const": "shell_region"}}},
      "then": {"required": ["region"]}
    },
    {
      "if": {"properties": {"kind": {"const": "action"}}},
      "then": {"required": ["action_contract"]}
    },
    {
      "if": {"properties": {"kind": {"const": "data_source"}}},
      "then": {"required": ["data_source_contract"]}
    },
    {
      "if": {"properties": {"kind": {"const": "settings"}}},
      "then": {"required": ["schema"]}
    },
    {
      "if": {"properties": {"kind": {"const": "ai_strategy"}}},
      "then": {"required": ["strategy_reference"]}
    },
    {"if":{"properties":{"kind":{"const":"view"}}},"then":{"properties":{"mode":{"const":"declarative"},"view":{"$ref":"#/$defs/catalog_view"}},"required":["view"]}}
  ],
  "$defs": {"id":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$","maxLength":256},"path":{"type":"string","maxLength":256,"pattern":"^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*){0,15}$"},"operation":{"type":"object","additionalProperties":false,"required":["contribution_id","contract_id","operation_id"],"properties":{"contribution_id":{"$ref":"#/$defs/id"},"contract_id":{"$ref":"#/$defs/id"},"operation_id":{"$ref":"#/$defs/id"}}},"input":{"type":"object","maxProperties":32},"request":{"type":"object","additionalProperties":false,"required":["contribution_id","contract_id","operation_id"],"properties":{"contribution_id":{"$ref":"#/$defs/id"},"contract_id":{"$ref":"#/$defs/id"},"operation_id":{"$ref":"#/$defs/id"},"input":{"$ref":"#/$defs/input"},"context_bindings":{"$ref":"#/$defs/context_bindings"}}},"field":{"type":"object","additionalProperties":false,"required":["label","path","kind"],"properties":{"label":{"type":"string","minLength":1,"maxLength":256},"path":{"$ref":"#/$defs/path"},"kind":{"enum":["text","status","progress"]},"total_path":{"$ref":"#/$defs/path"}}},"control":{"type":"object","additionalProperties":false,"required":["id","label","kind","operation"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1,"maxLength":256},"kind":{"enum":["button","toggle","text","choice"]},"operation":{"$ref":"#/$defs/operation"},"input":{"$ref":"#/$defs/input"},"input_bindings":{"type":"object","maxProperties":32,"additionalProperties":{"$ref":"#/$defs/path"}},"value_key":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"value_path":{"$ref":"#/$defs/path"},"options_path":{"$ref":"#/$defs/path"},"id_path":{"$ref":"#/$defs/path"},"label_path":{"$ref":"#/$defs/path"},"disabled_path":{"$ref":"#/$defs/path"},"multiple":{"type":"boolean"},"context_bindings":{"$ref":"#/$defs/context_bindings"}},"allOf":[{"if":{"properties":{"kind":{"enum":["toggle","text","choice"]}}},"then":{"required":["value_key"]}},{"if":{"properties":{"kind":{"const":"choice"}}},"then":{"required":["options_path","id_path","label_path"]}}]},"context_bindings":{"type":"object","maxProperties":16,"propertyNames":{"pattern":"^[a-z][a-z0-9_]{0,63}$"},"additionalProperties":{"enum":["conversation_id","turn_id"]}},"bindings":{"type":"object","maxProperties":32,"propertyNames":{"pattern":"^[a-z][a-z0-9_]{0,63}$"},"additionalProperties":{"$ref":"#/$defs/path"}},"condition":{"type":"object","additionalProperties":false,"required":["path","equals"],"properties":{"path":{"$ref":"#/$defs/path"},"equals":{"type":["string","number","boolean","null"],"maxLength":256}}},"record_save":{"type":"object","additionalProperties":false,"required":["operation","draft_key"],"properties":{"operation":{"$ref":"#/$defs/operation"},"input":{"$ref":"#/$defs/input"},"context_bindings":{"$ref":"#/$defs/context_bindings"},"source_bindings":{"$ref":"#/$defs/bindings"},"record_bindings":{"$ref":"#/$defs/bindings"},"draft_key":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"}}},"record_action":{"type":"object","additionalProperties":false,"required":["id","label","operation"],"properties":{"operation":{"$ref":"#/$defs/operation"},"input":{"$ref":"#/$defs/input"},"context_bindings":{"$ref":"#/$defs/context_bindings"},"source_bindings":{"$ref":"#/$defs/bindings"},"record_bindings":{"$ref":"#/$defs/bindings"},"id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1,"maxLength":256},"available_when":{"$ref":"#/$defs/condition"},"disabled_when":{"$ref":"#/$defs/condition"}}},"record_field":{"type":"object","additionalProperties":false,"required":["id","label","path","kind"],"properties":{"id":{"$ref":"#/$defs/id"},"label":{"type":"string","minLength":1,"maxLength":256},"path":{"$ref":"#/$defs/path"},"kind":{"enum":["text","multiline","integer","datetime","json"]},"required":{"type":"boolean"},"read_only":{"type":"boolean"},"min":{"type":"number"},"max":{"type":"number"}}},"record_column":{"type":"object","additionalProperties":false,"required":["label","path","kind"],"properties":{"label":{"type":"string","minLength":1,"maxLength":256},"path":{"$ref":"#/$defs/path"},"kind":{"enum":["text","status","datetime"]}}},"record_editor":{"type":"object","additionalProperties":false,"required":["records_path","id_path","title_path","fields","save"],"properties":{"records_path":{"$ref":"#/$defs/path"},"id_path":{"$ref":"#/$defs/path"},"title_path":{"$ref":"#/$defs/path"},"search_paths":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"$ref":"#/$defs/path"}},"columns":{"type":"array","maxItems":12,"items":{"$ref":"#/$defs/record_column"}},"fields":{"type":"array","minItems":1,"maxItems":16,"items":{"$ref":"#/$defs/record_field"}},"save":{"$ref":"#/$defs/record_save"},"actions":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/record_action"}}}},"thread_request":{"type":"object","additionalProperties":false,"required":["operation","turn_id_key"],"properties":{"operation":{"$ref":"#/$defs/operation"},"input":{"$ref":"#/$defs/input"},"context_bindings":{"$ref":"#/$defs/context_bindings"},"source_bindings":{"$ref":"#/$defs/bindings"},"turn_id_key":{"const":"turn_id"}}},"thread_send":{"type":"object","additionalProperties":false,"required":["operation","turn_id_key","content_key"],"properties":{"operation":{"$ref":"#/$defs/operation"},"input":{"$ref":"#/$defs/input"},"context_bindings":{"$ref":"#/$defs/context_bindings"},"source_bindings":{"$ref":"#/$defs/bindings"},"turn_id_key":{"const":"turn_id"},"content_key":{"const":"content"}}},"conversation_thread":{"type":"object","additionalProperties":false,"required":["conversation_path","messages_path","pending_turn_path","send"],"properties":{"conversation_path":{"$ref":"#/$defs/path"},"messages_path":{"$ref":"#/$defs/path"},"pending_turn_path":{"$ref":"#/$defs/path"},"model_reference_path":{"$ref":"#/$defs/path"},"send":{"$ref":"#/$defs/thread_send"},"stop":{"$ref":"#/$defs/thread_request"},"events":{"$ref":"#/$defs/thread_request"}}},"catalog_view":{"type":"object","additionalProperties":false,"required":["version","slot","renderer"],"properties":{"version":{"const":"tobkiri.ui.view.v1"},"slot":{"enum":["workspace_tab","sidebar","settings","chat_header","composer_above","composer_below"]},"renderer":{"enum":["panel","status","entity_picker","record_editor","conversation_thread"]},"title":{"type":"string","maxLength":256},"body":{"type":"string","maxLength":4096},"data_source":{"$ref":"#/$defs/request"},"fields":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/field"}},"controls":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/control"}},"record_editor":{"$ref":"#/$defs/record_editor"},"conversation_thread":{"$ref":"#/$defs/conversation_thread"}},"allOf":[{"if":{"properties":{"renderer":{"const":"record_editor"}}},"then":{"required":["record_editor"]},"else":{"not":{"required":["record_editor"]}}},{"if":{"properties":{"renderer":{"const":"conversation_thread"}}},"then":{"required":["conversation_thread","data_source"]},"else":{"not":{"required":["conversation_thread"]}}}]}}
}
