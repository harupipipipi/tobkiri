{
  "pack_id": "core_setup",
  "pack_identity": "core:rumi/setup",
  "version": "1.0.0",
  "vocabulary": {
    "types": []
  },
  "metadata": {
    "name": "Core Setup",
    "description": "Rumi AI OS core pack that provides initial setup functionality. Checks profile.json existence, validates and saves user profile data, and launches the setup UI when needed.",
    "author": "Rumi AI Team",
    "license": "MIT",
    "is_core_pack": true
  },
  "dependencies": {},
  "components": {},
  "web_mount": {
    "path_prefix": "/setup",
    "static_root": "web",
    "spa_fallback": true,
    "auth_required": false
  },
  "pre_auth_routes": [
    {
      "method": "GET",
      "path": "/api/setup/status"
    },
    {
      "method": "GET",
      "path": "/api/setup/oauth/start"
    },
    {
      "method": "GET",
      "path": "/callback"
    }
  ],
  "api_routes": [
    {
      "method": "GET",
      "path": "/api/setup/packs",
      "handler": "_setup_list_packs"
    },
    {
      "method": "GET",
      "path": "/api/setup/migration/status",
      "handler": "_setup_get_migration_status"
    },
    {
      "method": "POST",
      "path": "/api/setup/packs/install",
      "handler": "_setup_install_pack",
      "pass_body": true
    },
    {
      "method": "POST",
      "path_pattern": "/api/setup/packs/{id}/grant-all-ok",
      "handler": "_setup_grant_all_ok"
    },
    {
      "method": "POST",
      "path_pattern": "/api/setup/packs/{id}/revoke-all-ok",
      "handler": "_setup_revoke_all_ok"
    }
  ]
}
