{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.local/io.tobkiri/rumi-graph.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entrypoint_node_id", "nodes", "edges"],
  "properties": {
    "version": {"const": 1},
    "flow_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 32},
    "entrypoint_node_id": {"$ref": "#/$defs/node_id"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1026,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/edge"}
    }
  },
  "$defs": {
    "node_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "direction", "contracts"],
      "properties": {
        "id": {"$ref": "#/$defs/node_id"},
        "direction": {"enum": ["input", "output"]},
        "contracts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "contract_revision_digest", "operation_id", "function_principal_id", "input"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "contract_revision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "operation_id": {"type": "string", "minLength": 1},
        "function_principal_id": {"type": "string", "minLength": 1},
        "input": {"type": "object"}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "backoff_ms": {"type": "integer", "minimum": 0, "maximum": 86400000}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "data"],
      "properties": {
        "id": {"$ref": "#/$defs/node_id"},
        "type": {"enum": ["trigger", "step", "end"]},
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"}
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"const": "rumi_start"},
            "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
            "title": {"type": "string", "maxLength": 256},
            "description": {"type": "string", "maxLength": 4096},
            "request": {"$ref": "#/$defs/request"},
            "ports": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {"$ref": "#/$defs/port"}
            },
            "retry": {"$ref": "#/$defs/retry"},
            "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "trigger"}}},
          "then": {"properties": {"data": {"required": ["type", "ports"]}}}
        },
        {
          "if": {"properties": {"type": {"const": "step"}}},
          "then": {"properties": {"data": {"required": ["id", "request"]}}}
        },
        {
          "if": {"properties": {"type": {"const": "end"}}},
          "then": {"properties": {"data": {"required": ["ports"]}}}
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "sourceHandle", "targetHandle"],
      "properties": {
        "id": {"$ref": "#/$defs/node_id"},
        "source": {"$ref": "#/$defs/node_id"},
        "target": {"$ref": "#/$defs/node_id"},
        "sourceHandle": {"$ref": "#/$defs/node_id"},
        "targetHandle": {"$ref": "#/$defs/node_id"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"when": {"type": "string", "maxLength": 512}}
        }
      }
    }
  }
}
