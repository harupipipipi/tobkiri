{
  "id": "lmstudio",
  "provider_id": "lmstudio",
  "category": "providers",
  "kind": "llm_provider",
  "version": "1",
  "status": "experimental",
  "display_name": "LM Studio",
  "description": "Local LM Studio runtime with native installed-model discovery and OpenAI-compatible inference.",
  "entrypoints": {
    "adapter": "../ai_client/providers/lmstudio_provider.py"
  },
  "security": {
    "credential_required": false,
    "privacy": "local_by_default",
    "model_management_requires_explicit_action": true
  },
  "provider_metadata": {
    "display_name": "LM Studio",
    "kind": "local",
    "description": "Local LM Studio runtime with native installed-model discovery.",
    "env_vars": [
      "LMSTUDIO_API_TOKEN",
      "LM_API_TOKEN"
    ],
    "base_url_envs": [
      "LMSTUDIO_BASE_URL",
      "LMSTUDIO_SERVER_URL"
    ],
    "catalog_only": false,
    "supports_invoke": true,
    "default_base_url": "local://lmstudio",
    "default_model": "",
    "default_model_for": {},
    "catalog_features": [
      "chat",
      "streaming",
      "embedding",
      "vision",
      "tool_calls",
      "reasoning",
      "local",
      "openai_compatible",
      "runtime_model_discovery"
    ]
  },
  "provider_manifest": {
    "id": "lmstudio",
    "category": "llm_provider",
    "version": "2",
    "display_name": "LM Studio",
    "description": "Local LM Studio server with native installed-model discovery and OpenAI-compatible inference.",
    "enabled": true,
    "priority": 150,
    "adapter": "python_entrypoint",
    "entrypoint": "domain.ai_client.providers.lmstudio_provider:LMStudioProvider",
    "api_key_env": [
      "LMSTUDIO_API_TOKEN",
      "LM_API_TOKEN"
    ],
    "base_url_env": "LMSTUDIO_BASE_URL",
    "default_base_url": "local://lmstudio",
    "credential_required": false,
    "catalog_only": false,
    "supports_invoke": true,
    "config": {
      "api_compatibility": "openai",
      "inference_base_url_default": "http://127.0.0.1:1234/v1",
      "management_base_url_default": "http://127.0.0.1:1234",
      "management_base_url_env": "LMSTUDIO_SERVER_URL",
      "model_sync": "lmstudio_native",
      "model_list_path": "/api/v1/models",
      "model_load_path": "/api/v1/models/load",
      "model_unload_path": "/api/v1/models/unload",
      "model_cache_ttl_seconds": 60,
      "source_docs": "https://lmstudio.ai/docs/developer/rest/list"
    }
  },
  "aliases": {
    "provider_ids": [
      "lmstudio",
      "lm-studio"
    ]
  },
  "compatibility": {
    "legacy_ids": [
      "lmstudio",
      "lmstudio/local-model"
    ]
  },
  "source_pack_id": "rumi_model_catalog_pack",
  "catalog_features": [
    "chat",
    "streaming",
    "embedding",
    "vision",
    "tool_calls",
    "reasoning",
    "local",
    "openai_compatible",
    "runtime_model_discovery"
  ]
}
