{
  "id": "opencode-go",
  "provider_id": "opencode-go",
  "category": "providers",
  "kind": "llm_provider",
  "version": "1",
  "status": "stable",
  "display_name": "OpenCode Go",
  "description": "OpenCode Go subscription provider with OpenAI-compatible and Anthropic-compatible model endpoints.",
  "entrypoints": {
    "adapter": "../ai_client/providers/opencode_go_provider.py",
    "models": "models.json"
  },
  "security": {
    "credential_required": true,
    "fixed_model_allowlist": true,
    "privacy": "external_subscription_gateway"
  },
  "provider_metadata": {
    "display_name": "OpenCode Go",
    "kind": "cloud",
    "description": "OpenCode Go subscription provider with a mixed OpenAI chat completions and Anthropic messages transport.",
    "env_vars": [
      "OPENCODE_GO_API_KEY",
      "OPENCODE_ZEN_API_KEY"
    ],
    "base_url_envs": [
      "OPENCODE_GO_BASE_URL"
    ],
    "catalog_only": false,
    "supports_invoke": true,
    "default_base_url": "https://opencode.ai/zen/go/v1",
    "default_model": "kimi-k2.6",
    "default_model_for": {
      "chat": "kimi-k2.6",
      "coding": "kimi-k2.6",
      "general": "qwen3.7-plus",
      "fast": "deepseek-v4-flash",
      "cheap": "deepseek-v4-flash",
      "reasoning": "mimo-v2.5-pro",
      "vision": "qwen3.7-plus"
    },
    "catalog_features": [
      "chat",
      "streaming",
      "tool_calls",
      "reasoning",
      "vision",
      "openai_compatible",
      "anthropic_compatible"
    ]
  },
  "provider_manifest": {
    "id": "opencode-go",
