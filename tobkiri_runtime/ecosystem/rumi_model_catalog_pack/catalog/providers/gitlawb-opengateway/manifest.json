{
  "id": "gitlawb-opengateway",
  "provider_id": "gitlawb-opengateway",
  "category": "providers",
  "kind": "llm_provider",
  "version": "1",
  "status": "stable",
  "display_name": "Gitlawb OpenGateway",
  "entrypoints": {
    "adapter": "../ai_client/providers/gitlawb_opengateway_provider.py",
    "models": "models.json"
  },
  "security": {
    "credential_required": true,
    "credential_optional": false,
    "privacy": "external_api_key_gateway",
    "browser_user_agent": true,
    "fixed_model_allowlist": true
  },
  "provider_metadata": {
    "display_name": "Gitlawb OpenGateway",
    "kind": "aggregator",
    "description": "Gitlawb OpenGateway allowlist for MiMo. API keys are required for all OpenGateway models.",
    "env_vars": [
      "GITLAWB_OPENGATEWAY_API_KEY"
    ],
    "base_url_envs": [
      "GITLAWB_OPENGATEWAY_BASE_URL"
    ],
    "catalog_only": false,
    "supports_invoke": true,
    "default_base_url": "https://opengateway.gitlawb.com/v1",
    "default_model": "mimo-v2.5-pro",
    "default_model_for": {
      "chat": "mimo-v2.5-pro",
      "reasoning": "mimo-v2.5-pro",
      "fast": "mimo-v2-flash",
      "vision": "mimo-v2-omni"
    },
    "catalog_features": [
      "chat",
      "streaming",
      "openai_compatible",
      "reasoning",
      "vision"
    ]
  },
  "provider_manifest": {
    "id": "gitlawb-opengateway",
    "category": "llm_provider",
    "version": "1",
    "display_name": "Gitlawb OpenGateway",
    "enabled": true,
    "priority": 45,
    "adapter": "python_entrypoint",
    "entrypoint": "domain.ai_client.providers.gitlawb_opengateway_provider:GitlawbOpengatewayProvider",
    "api_key_env": "GITLAWB_OPENGATEWAY_API_KEY",
    "base_url_env": "GITLAWB_OPENGATEWAY_BASE_URL",
    "credential_required": true,
    "default_base_url": "https://opengateway.gitlawb.com/v1",
    "default_model": "mimo-v2.5-pro",
    "default_model_for": {
      "chat": "mimo-v2.5-pro",
      "reasoning": "mimo-v2.5-pro",
      "fast": "mimo-v2-flash",
      "vision": "mimo-v2-omni"
    },
    "config": {
      "model_sync": "fixed_allowlist",
      "privacy": "external_api_key_gateway",
      "optional_api_key": false
    }
  },
  "aliases": {
    "provider_ids": [
      "gitlawb-opengateway"
    ]
  },
  "compatibility": {
    "legacy_ids": [
      "gitlawb-opengateway",
      "gitlawb-opengateway/mimo-v2.5-pro",
      "gitlawb-opengateway/mimo-v2-flash",
      "gitlawb-opengateway/mimo-v2-omni",
      "gitlawb-opengateway/mimo-v2-pro",
      "gitlawb-opengateway/mimo-v2.5"
    ]
  },
  "source_pack_id": "rumi_model_catalog_pack",
  "catalog_features": [
    "chat",
    "streaming",
    "reasoning",
    "vision",
    "openai_compatible"
  ]
}
