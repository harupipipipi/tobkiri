{
  "id": "openrouter",
  "category": "llm_provider",
  "version": "1",
  "display_name": "OpenRouter",
  "enabled": true,
  "priority": 40,
  "adapter": "python_entrypoint",
  "entrypoint": "domain.ai_client.providers.openrouter_provider:OpenRouterProvider",
  "api_key_env": "OPENROUTER_API_KEY",
  "base_url_env": "OPENROUTER_BASE_URL",
  "credential_required": true,
  "catalog_only": false,
  "supports_invoke": true,
  "default_base_url": "https://openrouter.ai/api/v1",
  "default_model": "",
  "default_model_for": {},
  "config": {
    "api_compatibility": "openai",
    "model_sync": "live_inventory_with_lkg_fallback",
    "model_list_path": "/models"
  },
  "catalog_features": [
    "chat",
    "streaming",
    "tool_calls",
    "reasoning",
    "vision",
    "openai_compatible"
  ]
}
