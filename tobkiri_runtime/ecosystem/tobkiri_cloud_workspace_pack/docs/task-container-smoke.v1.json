    "import errno, json, os\nfrom pathlib import Path\nwork = os.statvfs('/workspace')\ntmp = os.statvfs('/tmp')\nassert os.getuid() != 0\nassert work.f_blocks * work.f_frsize == 8 * 1024 * 1024\nassert work.f_files == 512\nassert tmp.f_blocks * tmp.f_frsize == 16 * 1024 * 1024\nassert tmp.f_files == 256\nassert len(Path('/proc/net/route').read_text().splitlines()) == 1\nenospc = False\ntry:\n    with Path('quota-probe.bin').open('wb') as stream:\n        for _ in range(10):\n            stream.write(b'x' * (1024 * 1024))\nexcept OSError as exc:\n    assert exc.errno == errno.ENOSPC, repr(exc)\n    enospc = True\nfinally:\n    Path('quota-probe.bin').unlink(missing_ok=True)\nassert enospc\nreadonly = False\ntry:\n    with Path('/opt/task_runner.py').open('ab'):\n        pass\nexcept OSError as exc:\n    assert exc.errno in (errno.EROFS, errno.EACCES), repr(exc)\n    readonly = True\nassert readonly\nreport = {'uid': os.getuid(), 'gid': os.getgid(),\n          'workspace_bytes': work.f_blocks * work.f_frsize,\n          'workspace_inodes': work.f_files,\n          'tmp_bytes': tmp.f_blocks * tmp.f_frsize,\n          'tmp_inodes': tmp.f_files,\n          'network_routes': 0, 'quota_enospc': enospc,\n          'driver_readonly': readonly}\nPath('result.json').write_text(json.dumps(report, sort_keys=True) + '\\n')\nprint('Tobkiri actual bounded local task completed')\n"
