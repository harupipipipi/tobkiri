{
  "version": "rumi.ui.contribution.v1",
  "id": "tobkiri.cloud-workspace.workspace",
  "kind": "view",
  "mode": "declarative",
  "label": "Cloud workspace",
  "priority": 90,
  "accessibility": {
    "name": "Cloud workspace",
    "keyboard": true,
    "live": "polite"
  },
  "view": {
    "version": "tobkiri.ui.view.v1",
    "slot": "workspace_tab",
    "renderer": "panel",
    "title": "Cloud workspace",
    "body": "Save only the complete UTF-8 files you choose from your work folder. Separate file names with commas. Secret files and app settings cannot be included. Restore creates a read-only local copy. Preparing a handoff pauses local updates; it does not connect to the cloud or run work elsewhere. To prepare a local task, enter a command as a JSON list, for example [\"python3\", \"main.py\"]. Set up the work environment, approve the task in the approval window, then resume. The task runs in a separate copy without administrator privileges or network access. Check its limited output before applying the verified result as a new checkpoint. Local tasks require the work environment to be available on this computer and at most 4 MiB of work. If the environment is unavailable, tasks cannot run. Cloud connection and deployment are still in preparation.",
    "data_source": {
      "contribution_id": "pack.tobkiri_cloud_workspace_pack.tobkiri_cloud_workspace_pack.workspace-resource",
      "contract_id": "tobkiri.resource.cloud.workspace.v1",
      "operation_id": "tobkiri_cloud_workspace_pack.workspace-resource",
      "input": {
        "operation": "get_for_conversation"
      },
      "context_bindings": {
        "conversation_id": "conversation_id"
      }
    },
    "fields": [
      {
        "label": "State",
        "path": "workspace.status",
        "kind": "status"
      },
      {
        "label": "Checkpoint",
        "path": "workspace.checkpoint_digest",
        "kind": "text"
      },
      {
        "label": "Files",
        "path": "workspace.file_count",
        "kind": "text"
      },
      {
        "label": "Container",
        "path": "container.reason",
        "kind": "text"
      },
      {
        "label": "Cloud",
        "path": "cloud.reason",
        "kind": "text"
      },
      {
        "label": "Local task",
        "path": "task.status",
        "kind": "status"
      },
      {
        "label": "Task output",
        "path": "task.receipt.stdout",
        "kind": "text"
      },
      {
        "label": "Task error output",
        "path": "task.receipt.stderr",
        "kind": "text"
      }
    ],
    "controls": [
      {
        "id": "capture",
        "label": "Checkpoint selected workspace files (relative names)",
        "kind": "text",
        "value_key": "paths",
        "operation": {
          "contribution_id": "pack.tobkiri_cloud_workspace_pack.tobkiri_cloud_workspace_pack.workspace-manage",
          "contract_id": "tobkiri.action.cloud.workspace.v1",
          "operation_id": "tobkiri_cloud_workspace_pack.workspace-manage"
        },
        "input": {
          "operation": "capture"
        },
        "input_bindings": {
          "expected_revision": "workspace.revision",
          "expected_writer_epoch": "workspace.writer_epoch"
        },
        "context_bindings": {
          "conversation_id": "conversation_id"
        }
      },
      {
        "id": "import",
        "label": "Import a capsule (base64 ZIP)",
        "kind": "text",
        "value_key": "archive_base64",
        "operation": {
          "contribution_id": "pack.tobkiri_cloud_workspace_pack.tobkiri_cloud_workspace_pack.workspace-manage",
          "contract_id": "tobkiri.action.cloud.workspace.v1",
          "operation_id": "tobkiri_cloud_workspace_pack.workspace-manage"
        },
        "input": {
          "operation": "import"
        },
        "input_bindings": {
          "expected_revision": "workspace.revision",
          "expected_writer_epoch": "workspace.writer_epoch"
        },
        "context_bindings": {
          "conversation_id": "conversation_id"
        }
      },
      {
        "id": "verify",
        "label": "Verify local checkpoint",
        "kind": "button",
        "operation": {
          "contribution_id": "pack.tobkiri_cloud_workspace_pack.tobkiri_cloud_workspace_pack.workspace-resource",
          "contract_id": "tobkiri.resource.cloud.workspace.v1",
          "operation_id": "tobkiri_cloud_workspace_pack.workspace-resource"
        },
        "input": {
          "operation": "verify"
        },
        "input_bindings": {
          "workspace_id": "workspace.id",
          "expected_revision": "workspace.revision"
        }
      },
      {
        "id": "restore",
        "label": "Restore local copy",
        "kind": "button",
        "operation": {
          "contribution_id": "pack.tobkiri_cloud_workspace_pack.tobkiri_cloud_workspace_pack.workspace-manage",
          "contract_id": "tobkiri.action.cloud.workspace.v1",
          "operation_id": "tobkiri_cloud_workspace_pack.workspace-manage"
        },
        "input": {
          "operation": "restore"
        },
        "input_bindings": {
          "expected_revision": "workspace.revision",
          "expected_writer_epoch": "workspace.writer_epoch"
        },
        "context_bindings": {
          "conversation_id": "conversation_id"
        }
      },
      {
        "id": "handoff",
        "label": "Prepare future handoff",
        "kind": "button",
        "operation": {
          "contribution_id": "pack.tobkiri_cloud_workspace_pack.tobkiri_cloud_workspace_pack.workspace-manage",
          "contract_id": "tobkiri.action.cloud.workspace.v1",
          "operation_id": "tobkiri_cloud_workspace_pack.workspace-manage"
        },
        "input": {
          "operation": "prepare_handoff",
          "expected_receiver_head": ""
        },
        "input_bindings": {
          "expected_revision": "workspace.revision",
          "expected_writer_epoch": "workspace.writer_epoch"
        },
        "context_bindings": {
          "conversation_id": "conversation_id"
        }
      },
      {
        "id": "task_prepare",
        "label": "Prepare local task (JSON argv)",
        "kind": "text",
        "operation": {
          "contribution_id": "pack.tobkiri_cloud_workspace_pack.tobkiri_cloud_workspace_pack.workspace-manage",
          "contract_id": "tobkiri.action.cloud.workspace.v1",
          "operation_id": "tobkiri_cloud_workspace_pack.workspace-manage"
        },
        "input": {
          "operation": "task_prepare"
        },
        "input_bindings": {
          "expected_revision": "workspace.revision",
          "expected_writer_epoch": "workspace.writer_epoch"
        },
        "context_bindings": {
          "conversation_id": "conversation_id"
        },
        "value_key": "argv_json"
      },
      {
        "id": "task_resume",
        "label": "Resume approved local task",
        "kind": "button",
        "operation": {
          "contribution_id": "pack.tobkiri_cloud_workspace_pack.tobkiri_cloud_workspace_pack.workspace-manage",
          "contract_id": "tobkiri.action.cloud.workspace.v1",
          "operation_id": "tobkiri_cloud_workspace_pack.workspace-manage"
        },
        "input": {
          "operation": "task_resume"
        },
        "input_bindings": {
          "expected_revision": "workspace.revision",
          "expected_writer_epoch": "workspace.writer_epoch"
        },
        "context_bindings": {
          "conversation_id": "conversation_id"
        }
      },
      {
        "id": "task_status",
        "label": "Refresh task status",
        "kind": "button",
        "operation": {
          "contribution_id": "pack.tobkiri_cloud_workspace_pack.tobkiri_cloud_workspace_pack.workspace-manage",
          "contract_id": "tobkiri.action.cloud.workspace.v1",
          "operation_id": "tobkiri_cloud_workspace_pack.workspace-manage"
        },
        "input": {
          "operation": "task_status"
        },
        "input_bindings": {
          "expected_revision": "workspace.revision",
          "expected_writer_epoch": "workspace.writer_epoch"
        },
        "context_bindings": {
          "conversation_id": "conversation_id"
        }
      },
      {
        "id": "task_cancel",
        "label": "Cancel local task",
        "kind": "button",
        "operation": {
          "contribution_id": "pack.tobkiri_cloud_workspace_pack.tobkiri_cloud_workspace_pack.workspace-manage",
          "contract_id": "tobkiri.action.cloud.workspace.v1",
          "operation_id": "tobkiri_cloud_workspace_pack.workspace-manage"
        },
        "input": {
          "operation": "task_cancel"
        },
        "input_bindings": {
          "expected_revision": "workspace.revision",
          "expected_writer_epoch": "workspace.writer_epoch"
        },
        "context_bindings": {
          "conversation_id": "conversation_id"
        }
      },
      {
        "id": "task_apply",
        "label": "Apply verified task output as checkpoint",
        "kind": "button",
        "operation": {
          "contribution_id": "pack.tobkiri_cloud_workspace_pack.tobkiri_cloud_workspace_pack.workspace-manage",
          "contract_id": "tobkiri.action.cloud.workspace.v1",
          "operation_id": "tobkiri_cloud_workspace_pack.workspace-manage"
        },
        "input": {
          "operation": "task_apply"
        },
        "input_bindings": {
          "expected_revision": "workspace.revision",
          "expected_writer_epoch": "workspace.writer_epoch"
        },
        "context_bindings": {
          "conversation_id": "conversation_id"
        }
      }
    ]
  }
}
