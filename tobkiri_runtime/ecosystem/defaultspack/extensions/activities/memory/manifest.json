{
  "$schema": "https://schemas.tobkiri.dev/activity/v1.json",
  "schema_version": "tobkiri.activity/v1",
  "kind": "activity",
  "id": "memory",
  "version": "1.0.0",
  "display_name": {"ja": "Memory", "en": "Memory"},
  "description": {
    "ja": "保存された記憶を検索、確認、整理します。",
    "en": "Search, inspect, and organize saved memory."
  },
  "aliases": ["remember", "recall", "記憶", "メモリ"],
  "members": {
    "tool_ids": [
      "memo_search_notes",
      "memo_get_note",
      "memo_list_notes",
      "memo_upsert_note"
    ],
    "tool_tags": ["activity:memory"],
    "skills": {"required": [], "optional": [], "safety": []}
  },
  "selection": {
    "explicit_intent_required": false,
    "schema_policy": "progressive",
    "max_candidate_tools": 12,
    "max_attached_tools": 6
  },
  "permissions": {
    "default_action_class": "read",
    "minimum": "auto"
  },
  "ui": {
    "mentionable": true,
    "pinnable": true,
    "default_pinned": false,
    "widget": "memory-status"
  }
}
