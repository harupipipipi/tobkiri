{
  "$schema": "https://schemas.tobkiri.dev/activity/v1.json",
  "schema_version": "tobkiri.activity/v1",
  "kind": "activity",
  "id": "research",
  "version": "1.0.0",
  "display_name": {"ja": "Research", "en": "Research"},
  "description": {
    "ja": "Web、資料、ファイルを横断して調査します。",
    "en": "Research across the web, documents, and files."
  },
  "aliases": ["investigate", "study", "調査", "リサーチ"],
