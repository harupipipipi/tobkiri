{
  "module_id": "rumi_bundle",
  "kind": "frontend",
  "display_name": "Tobkiri Bundle Surface",
  "description": "Standalone defaultspack bundle metadata for a future desktop-app surface that opens the pack frontend on its assigned port.",
  "dependencies": [],
  "default_state": "experimental",
  "failure_threshold": 2,
  "experimental": true,
  "bundle": {
    "bundle_id": "rumi_bundle",
    "pack_id": "defaultspack",
    "launch_mode": "desktop_app",
    "entry_url": "http://127.0.0.1:${RUMI_DEFAULTSPACK_PORT}",
    "port_source": {
      "env": "RUMI_DEFAULTSPACK_PORT",
      "default": 8766
    },
    "app": {
      "id": "defaultspack",
      "name": "Tobkiri",
      "icon": "/static/assets/icons/defaultspack-icon.png"
    }
  }
}
