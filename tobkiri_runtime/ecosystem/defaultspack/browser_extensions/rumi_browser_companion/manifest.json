{
  "manifest_version": 3,
  "name": "Tobkiri Browser Companion",
  "description": "MV3 browser companion for the local Tobkiri bridge.",
  "version": "0.2.0",
  "minimum_chrome_version": "114",
  "x_rumi_search_home_origins": [
    "http://127.0.0.1:8777"
  ],
  "permissions": [
    "activeTab",
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Tobkiri Browser Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
