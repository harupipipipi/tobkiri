{
  "schema_version": 1,
  "id": "rumi.api_keys.default",
  "kind": "integration",
  "version": "1.0.0",
  "status": "active",
  "trust_level": "builtin",
  "capabilities": {
    "provides": [
      "rumi.api_keys",
      "rumi.provider_credentials"
    ],
    "requires": [],
    "permissions": [
      "api_key.use"
    ]
  },
  "metadata": {
    "title": "Default API Key Setup",
    "template_kind": "setup_template",
    "local_first": true,
    "description": "Declarative metadata for provider API key setup without exposing secrets."
  },
  "pieces": [
    {
      "id": "api_key_settings_section",
      "kind": "settings_section",
      "order": 10,
      "section_id": "apis",
      "label": "APIs / Tokens",
      "description": "Provider credentials are saved through the existing local secret-aware settings flow.",
      "fields": []
    },
    {
      "id": "provider_select",
      "kind": "settings_field",
      "slot": "apis",
      "order": 12,
      "section_id": "apis",
      "type": "provider_select",
      "renderer": "provider_select",
      "component": "SettingsFieldRendererHost",
      "part_id": "settings",
      "label": "Provider",
      "default": "openrouter",
      "data_source": "ai_providers",
      "options": [
        {"value": "line", "label": "LINE", "provider_id": "line", "kind": "custom", "builtin": true},
        {"value": "discord", "label": "Discord", "provider_id": "discord", "kind": "custom", "builtin": true},
        {"value": "slack", "label": "Slack", "provider_id": "slack", "kind": "custom", "builtin": true},
        {"value": "generic", "label": "Generic", "provider_id": "generic", "kind": "custom", "builtin": true},
        {"value": "web", "label": "Web", "provider_id": "web", "kind": "custom", "builtin": true}
      ]
    },
    {
      "id": "api_key_setup",
      "kind": "settings_field",
      "slot": "apis",
      "order": 13,
      "section_id": "apis",
      "field_id": "api_keys",
      "type": "api_key_setup",
      "renderer": "api_key_setup",
      "component": "SettingsFieldRendererHost",
      "part_id": "settings",
      "label": "API Keys / Tokens",
      "provider_scope": "non_llm",
      "default": [],
      "data_source": "provider_key_status",
      "write_route": "/api/ui/settings",
      "options": [
        {"value": "line", "label": "LINE", "provider_id": "line", "kind": "custom", "builtin": true},
        {"value": "discord", "label": "Discord", "provider_id": "discord", "kind": "custom", "builtin": true},
        {"value": "slack", "label": "Slack", "provider_id": "slack", "kind": "custom", "builtin": true},
        {"value": "generic", "label": "Generic", "provider_id": "generic", "kind": "custom", "builtin": true},
        {"value": "web", "label": "Web", "provider_id": "web", "kind": "custom", "builtin": true}
      ],
      "help": "provider を選び、名前と値を貼って Save。LINE / Discord / Slack を選ぶと外部送信側の token としても自動で利用できます。"
    },
    {
      "id": "api_key_field_renderer",
      "kind": "field_renderer",
      "order": 14,
      "renderer": "api_key_setup",
      "component": "SettingsFieldRendererHost",
      "part_id": "settings",
      "field_types": [
        "api_key_setup",
        "provider_select",
        "model_select"
      ]
    },
    {
      "id": "provider_key_status_data_source",
      "kind": "function",
      "order": 15,
      "role": "data_source",
      "data_source": "provider_key_status",
      "function_id": "ai_get_provider_key_status",
      "permission_id": "api_key.use",
      "handler_ref": "blocks.ai.provider_key:run",
      "route_path": "/api/ai/provider-key",
      "method": "GET",
      "returns": "configured provider key summaries only"
    },
    {
      "id": "save_provider_key_action",
      "kind": "function",
      "order": 16,
      "role": "action",
      "action_id": "ai_set_provider_api_key",
      "function_id": "ai_set_provider_key",
      "permission_id": "api_key.use",
      "handler_ref": "blocks.ai.provider_key:run",
      "route_path": "/api/ai/provider-key",
      "method": "POST",
      "default_args": {
        "_method": "POST"
      },
      "requires_approval": true,
      "pre_auth": true,
      "sensitive": true
    },
    {
      "id": "provider_key_store_service",
      "kind": "backend_service",
      "order": 17,
      "service_id": "provider_api_key_store",
      "entrypoint": "domain.ai_client.api_key_store",
      "lifecycle": "local_secret_store"
    },
    {
      "id": "api_key_use_permission",
      "kind": "permission",
      "order": 19,
      "permission_id": "api_key.use",
      "override": {
        "mode": "replace",
        "target_projected_id": "rumi.backend.model_routing.default:model_route_api_key_permission"
      },
      "scope": "ai_client",
      "reason": "Provider keys are secret material and must stay approval-aware."
    },
    {
      "id": "api_key_setup_test_contract",
      "kind": "test_contract",
      "order": 20,
      "contract_id": "defaultspack.template.api_keys.catalog",
      "route_metadata": {
        "method": "POST",
        "path": "/api/ai/provider-key",
        "block_module": "blocks.ai.provider_key",
        "diagnostic": "Template function route_path is projected to transport when it is not already covered by a builtin route."
      },
      "assertions": [
        {"type": "catalog_contains", "bucket": "actions", "match": {"action_id": "ai_set_provider_api_key"}},
        {"type": "catalog_contains", "bucket": "data_sources", "match": {"data_source": "provider_key_status"}},
        {"type": "setting_field_exists", "section_id": "apis", "field_id": "api_keys", "field_type": "api_key_setup"},
        {"type": "route_resolves", "method": "POST", "path": "/api/ai/provider-key"},
        {"type": "function_registered", "function_id": "ai_set_provider_key"},
        {"type": "permission_declared", "permission_id": "api_key.use"}
      ]
    }
  ]
}
