        {
            "id": "model_selector_test_contract",
            "kind": "test_contract",
            "order": 59,
            "contract_id": "defaultspack.template.model_selector.catalog",
            "route_metadata": {
                "method": "GET",
                "path": "/api/ai/models",
                "block_module": "blocks.ai.models",
                "diagnostic": "Template function route_path is projected to transport when it is not already covered by a builtin route."
            },
            "assertions": [
                {
                    "type": "template_projectable",
                    "template_id": "rumi.model_selector.default"
                },
                {
                    "type": "catalog_contains",
