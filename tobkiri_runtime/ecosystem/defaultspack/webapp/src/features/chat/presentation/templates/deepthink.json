{
  "schema_version": 1,
  "id": "defaultspack.deepthink.v1",
  "title": "DeepThink",
  "aria_label": "DeepThink progress",
  "icon": "brain-circuit",
  "tone": "violet-sky",
  "motion": {
    "entry": "rise",
    "surface": "aurora",
    "indicator": "orbit",
    "active_phase": "signal"
  },
  "event": {
    "template_id_field": "presentation_template_id",
    "phase_field": "deepthink_phase",
    "phase_prefix": "deepthink_"
  },
  "phases": [
    { "id": "preflight", "label": "確認", "description": "実行条件を確認" },
    { "id": "planning", "label": "計画", "description": "回答の進め方を設計" },
    { "id": "capability_assessment", "label": "能力評価", "description": "モデルの限界と作業手段を検討" },
    { "id": "integrations", "label": "連携", "description": "toolとskillを選定" },
    { "id": "evidence", "label": "根拠", "description": "情報と論点を整理" },
    { "id": "drafting", "label": "下書き", "description": "回答を組み立て" },
    { "id": "synthesizing", "label": "統合", "description": "内容を一つに統合" },
    { "id": "reviewing", "label": "レビュー", "description": "品質と漏れを確認" },
    { "id": "revising", "label": "修正", "description": "指摘を回答へ反映" }
  ],
  "dynamic_phases": {
    "insert_after": "integrations",
    "excluded": ["action", "completed", "paused", "failed", "profile_phases", "dispatch", "dispatch_completed"]
  },
  "statuses": {
    "running": "実行中",
    "completed": "完了",
    "paused": "一時停止",
    "failed": "失敗"
  },
  "feedback": {
    "reviewing": "改善点が見つかったため、回答を修正しています。",
    "approved": "レビューを通過した回答です。"
  }
}
