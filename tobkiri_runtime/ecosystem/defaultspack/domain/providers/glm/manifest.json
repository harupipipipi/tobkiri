    "default_model_for": {},
    "catalog_features": [
      "chat",
      "streaming",
      "tool_calls",
      "openai_compatible"
    ]
  },
  "provider_manifest": {
    "id": "glm",
    "category": "llm_provider",
    "version": "1",
    "display_name": "GLM",
    "enabled": true,
    "priority": 80,
    "adapter": "openai_compatible",
    "api_key_env": "GLM_API_KEY",
    "base_url_env": "GLM_BASE_URL",
    "default_base_url": "https://open.bigmodel.cn/api/paas/v4",
    "credential_required": true,
    "default_model": "glm-4.5",
    "catalog_features": [
      "chat",
      "streaming",
      "tool_calls",
      "openai_compatible"
    ],
    "catalog_only": false,
    "supports_invoke": true,
    "config": {
      "inventory_strategy": "authenticated_models_api",
