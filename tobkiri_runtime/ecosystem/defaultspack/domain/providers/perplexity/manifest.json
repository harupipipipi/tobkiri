{
  "id": "perplexity",
  "provider_id": "perplexity",
  "category": "providers",
  "kind": "llm_provider",
  "version": "1",
  "status": "stable",
  "display_name": "Perplexity",
  "description": "Perplexity direct hosted provider with canonical account inventory.",
  "entrypoints": {
    "adapter": "../ai_client/providers/openai_compatible_provider.py",
    "models": "models.json"
  },
  "security": {
    "credential_required": true
  },
  "provider_metadata": {
    "display_name": "Perplexity",
    "kind": "aggregator",
    "env_vars": [
      "PERPLEXITY_API_KEY"
    ],
    "base_url_envs": [
      "PERPLEXITY_BASE_URL"
    ],
    "catalog_only": false,
    "supports_invoke": true,
    "default_model": "sonar-pro",
    "default_base_url": "https://api.perplexity.ai",
    "default_model_for": {},
    "catalog_features": [
      "chat",
      "streaming"
    ]
  },
  "provider_manifest": {
    "id": "perplexity",
    "category": "llm_provider",
    "version": "1",
    "display_name": "Perplexity",
    "enabled": true,
    "priority": 130,
    "adapter": "openai_compatible",
    "api_key_env": "PERPLEXITY_API_KEY",
    "base_url_env": "PERPLEXITY_BASE_URL",
    "default_base_url": "https://api.perplexity.ai",
    "credential_required": true,
    "default_model": "sonar-pro",
    "catalog_only": false,
    "supports_invoke": true,
    "config": {
      "inventory_strategy": "authenticated_models_api",
      "inventory_scope": "account",
      "model_sync": "remote_merge",
      "model_list_path": "/models",
      "model_cache_ttl_seconds": 21600,
      "source_docs": "https://docs.perplexity.ai/getting-started/models"
    }
  },
  "aliases": {
    "provider_ids": [
      "perplexity"
    ]
  },
  "source_pack_id": "defaultspack",
  "catalog_features": [
    "chat",
    "streaming"
  ]
}
