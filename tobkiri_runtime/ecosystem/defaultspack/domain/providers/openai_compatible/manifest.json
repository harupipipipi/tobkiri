{
  "id": "openai_compatible",
  "provider_id": "openai_compatible",
  "category": "providers",
  "kind": "llm_provider",
  "version": "2",
  "status": "stable",
  "display_name": "OpenAI Compatible Connections",
  "description": "User-defined OpenAI-compatible endpoints with isolated connection inventory.",
  "entrypoints": {"adapter": "../ai_client/providers/generic_openai_compatible_provider.py"},
  "security": {"credential_required": false, "secret_storage": "environment_reference_only"},
  "provider_metadata": {
    "display_name": "OpenAI Compatible",
