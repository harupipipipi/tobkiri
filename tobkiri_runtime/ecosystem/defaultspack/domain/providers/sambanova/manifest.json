{
  "id": "sambanova",
  "provider_id": "sambanova",
  "category": "providers",
  "kind": "llm_provider",
  "version": "1",
  "status": "stable",
  "display_name": "SambaNova Cloud",
  "description": "SambaNova Cloud direct hosted API with live account-visible model discovery.",
  "provider_metadata": {
    "display_name": "SambaNova Cloud",
    "kind": "cloud",
    "env_vars": [
      "SAMBANOVA_API_KEY"
    ],
    "base_url_envs": [
      "SAMBANOVA_BASE_URL"
    ],
    "catalog_only": false,
    "supports_invoke": true,
    "default_model": "",
    "default_base_url": "https://api.sambanova.ai/v1",
    "default_model_for": {},
    "catalog_features": [
      "chat",
      "streaming",
      "openai_compatible",
      "remote_model_discovery"
    ]
  },
  "provider_manifest": {
    "id": "sambanova",
    "category": "llm_provider",
    "version": "1",
    "display_name": "SambaNova Cloud",
    "enabled": true,
    "priority": 220,
    "adapter": "openai_compatible",
    "api_key_env": "SAMBANOVA_API_KEY",
    "base_url_env": "SAMBANOVA_BASE_URL",
    "default_base_url": "https://api.sambanova.ai/v1",
    "credential_required": true,
    "catalog_only": false,
    "supports_invoke": true,
    "config": {
      "api_compatibility": "openai",
      "model_sync": "remote_merge",
      "model_list_path": "/models",
      "model_cache_ttl_seconds": 21600,
      "inventory_scope": "account",
      "source_docs": "https://docs.sambanova.ai/cloud/docs/get-started/overview"
    }
  },
  "aliases": {
    "provider_ids": [
      "sambanova"
    ]
  },
  "source_pack_id": "defaultspack",
  "catalog_features": [
    "chat",
    "streaming",
    "openai_compatible",
    "remote_model_discovery"
  ]
}
