{
  "id": "mistral",
  "provider_id": "mistral",
  "category": "providers",
  "kind": "llm_provider",
  "version": "1",
  "status": "stable",
  "display_name": "Mistral",
  "description": "Mistral direct hosted provider with canonical account inventory.",
  "entrypoints": {
    "adapter": "../ai_client/providers/openai_compatible_provider.py",
    "models": "models.json"
  },
  "security": {
    "credential_required": true
  },
  "provider_metadata": {
    "display_name": "Mistral",
    "kind": "cloud",
    "env_vars": [
      "MISTRAL_API_KEY"
    ],
    "base_url_envs": [
      "MISTRAL_BASE_URL"
    ],
    "catalog_only": false,
    "supports_invoke": true,
    "default_model": "mistral-large-latest",
    "default_base_url": "https://api.mistral.ai/v1",
    "default_model_for": {},
    "catalog_features": [
      "chat",
      "streaming"
    ]
  },
  "provider_manifest": {
    "id": "mistral",
    "category": "llm_provider",
    "version": "1",
    "display_name": "Mistral",
    "enabled": true,
    "priority": 110,
    "adapter": "openai_compatible",
    "api_key_env": "MISTRAL_API_KEY",
    "base_url_env": "MISTRAL_BASE_URL",
    "default_base_url": "https://api.mistral.ai/v1",
    "credential_required": true,
    "default_model": "mistral-large-latest",
    "catalog_only": false,
    "supports_invoke": true,
    "config": {
      "inventory_strategy": "authenticated_models_api",
      "inventory_scope": "account",
      "model_sync": "remote_merge",
      "model_list_path": "/models",
      "model_cache_ttl_seconds": 21600,
      "source_docs": "https://docs.mistral.ai/getting-started/models/models_overview/"
    }
  },
  "aliases": {
    "provider_ids": [
      "mistral"
    ]
  },
  "source_pack_id": "defaultspack",
  "catalog_features": [
    "chat",
    "streaming"
  ]
}
