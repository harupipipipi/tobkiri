{
  "id": "inference-net",
  "provider_id": "inference-net",
  "category": "providers",
  "kind": "llm_provider",
  "version": "1",
  "status": "stable",
  "display_name": "Inference.net",
  "description": "Inference.net direct hosted API with live account-visible model discovery.",
  "provider_metadata": {
    "display_name": "Inference.net",
    "kind": "cloud",
    "env_vars": [
      "INFERENCE_NET_API_KEY"
    ],
    "base_url_envs": [
      "INFERENCE_NET_BASE_URL"
    ],
    "catalog_only": false,
    "supports_invoke": true,
    "default_model": "",
    "default_base_url": "https://api.inference.net/v1",
    "default_model_for": {},
    "catalog_features": [
      "chat",
      "streaming",
      "openai_compatible",
      "remote_model_discovery"
    ]
  },
  "provider_manifest": {
    "id": "inference-net",
    "category": "llm_provider",
    "version": "1",
    "display_name": "Inference.net",
    "enabled": true,
    "priority": 220,
    "adapter": "openai_compatible",
    "api_key_env": "INFERENCE_NET_API_KEY",
    "base_url_env": "INFERENCE_NET_BASE_URL",
    "default_base_url": "https://api.inference.net/v1",
    "credential_required": true,
    "catalog_only": false,
    "supports_invoke": true,
    "config": {
      "api_compatibility": "openai",
      "model_sync": "remote_merge",
      "model_list_path": "/models",
      "model_cache_ttl_seconds": 21600,
      "inventory_scope": "account",
      "source_docs": "https://docs.inference.net/"
    }
  },
  "aliases": {
    "provider_ids": [
      "inference-net"
    ]
  },
  "source_pack_id": "defaultspack",
  "catalog_features": [
    "chat",
    "streaming",
    "openai_compatible",
    "remote_model_discovery"
  ]
}
