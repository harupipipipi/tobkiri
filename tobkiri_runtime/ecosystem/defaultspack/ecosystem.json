  "metadata": {
    "name": "Rumi Defaultspack v2",
    "description": "Primary v2 pack cloned from defaults and extended with canonical defaultspack management APIs.",
    "author": "Rumi AI Team",
    "license": "MIT"
  },
  "capability_bindings": {
    "register": "ecosystem.defaultspack.capability_bindings.register_defaultspack_binding_handlers"
  },
  "capabilities": [
    "desktop_app.execute"
  ],
  "desktop_app": {
    "command": "python defaultspack/desktop_app.py",
    "working_dir": "",
    "env": {
      "DEFAULTS_HTTP_PORT": "8766",
      "RUMI_DEFAULTSPACK_PORT": "8766",
      "RUMI_DEFAULTSPACK_SURFACE": "webview"
    },
    "capabilities": [
      "desktop_app.execute"
    ],
    "window": {
      "title": "Rumi Defaultspack",
      "width": 1280,
      "height": 800,
      "icon": "assets/icons/defaultspack-icon.png"
    },
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ]
  },
  "pre_auth_routes": [
    {
      "method": "POST",
      "path": "/api/integrations/line/webhook"
    },
    {
      "method": "POST",
      "path": "/api/integrations/slack/events"
    },
    {
      "method": "POST",
      "path": "/api/integrations/discord/interactions"
    },
    {
      "method": "POST",
      "path": "/api/integrations/discord/events"
    },
    {
      "method": "POST",
      "path": "/api/integrations/p2p/events"
    },
    {
      "method": "POST",
      "path_prefix": "/api/webhooks/inbound"
    }
  ],
  "api_routes": [
    {
      "method": "GET",
      "path": "/api/onboarding/status",
      "function_id": "adaptive_onboarding_status"
    },
    {
      "method": "GET",
      "path": "/api/onboarding/schema",
      "function_id": "adaptive_onboarding_schema"
    },
    {
      "method": "POST",
      "path": "/api/onboarding/answers/normalize",
      "function_id": "adaptive_onboarding_normalize",
      "pass_body": true
    },
    {
      "method": "POST",
      "path": "/api/onboarding/compile",
      "function_id": "adaptive_onboarding_compile",
      "pass_body": true
    },
    {
      "method": "POST",
      "path": "/api/onboarding/simulate",
      "function_id": "adaptive_onboarding_simulate",
      "pass_body": true
    },
    {
      "method": "POST",
      "path": "/api/onboarding/apply",
      "function_id": "adaptive_onboarding_apply",
      "pass_body": true,
      "sensitive": true
    },
    {
      "method": "POST",
      "path": "/api/onboarding/undo",
      "function_id": "adaptive_onboarding_undo",
      "pass_body": true
    },
    {
      "method": "GET",
      "path": "/api/onboarding/history",
      "function_id": "adaptive_onboarding_history",
      "pass_query": true
    },
    {
      "method": "POST",
      "path": "/api/onboarding/rediagnose",
      "function_id": "adaptive_onboarding_rediagnose",
      "pass_body": true
    },
    {
      "method": "GET",
      "path": "/api/operating-profiles",
      "function_id": "adaptive_operating_profiles_list"
    },
    {
      "method": "GET",
      "path_pattern": "/api/operating-profiles/{id}",
      "function_id": "adaptive_operating_profiles_get",
      "path_param_map": {
        "id": "id"
      }
    },
    {
      "method": "POST",
      "path": "/api/operating-profiles",
      "function_id": "adaptive_operating_profiles_create",
      "pass_body": true
    },
    {
      "method": "PUT",
      "path_pattern": "/api/operating-profiles/{id}",
      "function_id": "adaptive_operating_profiles_update",
      "pass_body": true,
      "path_param_map": {
        "id": "id"
      }
    },
    {
      "method": "POST",
      "path_pattern": "/api/operating-profiles/{id}/preview",
      "function_id": "adaptive_operating_profiles_preview",
      "pass_body": true,
      "path_param_map": {
        "id": "id"
      }
    },
    {
      "method": "POST",
      "path_pattern": "/api/operating-profiles/{id}/activate",
      "function_id": "adaptive_operating_profiles_activate",
