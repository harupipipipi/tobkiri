{
  "id": "coding_file_read",
  "category": "tool",
  "version": "1",
  "display_name": "Read File",
  "description": "Read a workspace file through the coding file block.",
  "enabled": true,
  "config": {
    "name": "coding_file_read",
    "summary": "Read a workspace file",
    "tags": [
      "coding",
      "file",
      "read"
    ],
    "ui": {
      "group_id": "coding/files/read",
      "group_label": "Read",
      "group_icon": "file",
      "drop_capabilities": [
        "composer.toggle_chip"
      ],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {
          "id": "default_workspace_root",
          "label": "Default Workspace Root",
          "type": "text",
          "default": "",
          "help": "Durable root used when a workspace root is not provided by the runtime."
        }
      ]
    },
    "tool_category": "filesystem",
    "action_type": "read",
    "risk": "low",
    "approval_policy": "allow",
    "capability_grants": [
      "file.read"
    ],
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "execution": {
      "type": "global_contract",
      "contract_id": "tobkiri.service.tool.local.operation.v1",
      "provider_instance_id": "rumi_default_tools_pack.files-read",
      "operation": "rumi_default_tools_pack.files-read-operation"
    }
  }
}
