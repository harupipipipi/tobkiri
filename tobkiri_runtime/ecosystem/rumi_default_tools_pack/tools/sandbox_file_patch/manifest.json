{
  "id": "sandbox_file_patch",
  "category": "tool",
  "version": "1",
  "display_name": "Sandbox Patch File",
  "description": "Patch a file inside the sandbox copy only. Host application requires a separate trusted patch.",
  "enabled": true,
  "config": {
    "name": "sandbox_file_patch",
    "summary": "Patch a sandbox file",
    "tags": ["sandbox", "coding", "file", "patch"],
    "ui": {
      "group_id": "sandbox/coding/files",
      "group_label": "Sandbox Files",
      "group_icon": "box",
      "widget_kind": "tool_toggle"
    },
    "tool_category": "sandbox",
    "action_type": "sandbox_write",
    "risk": "low",
    "approval_policy": "allow",
    "capability_grants": ["sandbox.workspace.write"],
    "write_action": false,
    "requires_approval": false,
    "schema": {
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workspace_id": {"type": "string"},
          "sandbox_id": {"type": "string", "minLength": 1},
          "path": {"type": "string"},
          "old": {"type": "string"},
          "new": {"type": "string"},
          "include_paths": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["sandbox_id", "path", "old", "new"]
      }
    },
    "execution": {"type": "rumi_function", "qualified_name": "defaultspack:sandbox_file_patch"}
  }
}
