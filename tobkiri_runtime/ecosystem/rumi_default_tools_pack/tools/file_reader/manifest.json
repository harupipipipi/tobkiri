{
  "id": "file_reader",
  "category": "tool",
  "version": "1",
  "display_name": "File Reader",
  "description": "Read file content from a path.",
  "enabled": true,
  "config": {
    "name": "file_reader",
    "summary": "ファイル読み取り",
    "tags": [
      "io",
      "file"
    ],
    "ui": {
      "group_id": "coding/files/read",
      "group_label": "Read",
      "group_icon": "file",
      "settings_fields": [
        {
          "id": "include_line_numbers",
          "label": "Line numbers",
          "type": "toggle",
          "default": true,
          "help": "Saved preference for formatting file excerpts."
        },
        {
          "id": "preview_line_limit",
          "label": "Preview line limit",
          "type": "number",
          "default": 200,
          "min": 20,
          "max": 2000,
          "help": "Saved preference for how much file content to show by default."
        },
        {
          "id": "default_encoding",
          "label": "Default encoding",
          "type": "select",
          "default": "utf-8",
          "options": [
            {
              "value": "utf-8",
              "label": "UTF-8"
            },
            {
              "value": "utf-8-sig",
              "label": "UTF-8 with BOM"
            },
            {
              "value": "shift_jis",
              "label": "Shift JIS"
            }
          ],
          "help": "Saved preference used when a file has no explicit encoding hint.",
          "advanced": true
        }
      ]
    },
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "tool_category": "filesystem",
    "action_type": "read",
    "risk": "low",
    "approval_policy": "allow",
    "capability_grants": [
      "file.read"
    ],
    "execution": {
      "type": "global_contract",
      "contract_id": "tobkiri.service.tool.local.operation.v1",
      "provider_instance_id": "rumi_default_tools_pack.files-read",
      "operation": "rumi_default_tools_pack.files-read-operation"
    }
  }
}
