{
  "id": "coding_file_list",
  "category": "tool",
  "version": "1",
  "display_name": "List Files",
  "description": "List files under a workspace directory.",
  "enabled": true,
  "config": {
    "name": "coding_file_list",
    "summary": "List workspace files",
    "tags": [
      "coding",
      "file",
      "read"
    ],
    "ui": {
      "group_id": "coding/files/read",
      "group_label": "Read",
      "group_icon": "file",
      "drop_capabilities": [
        "composer.toggle_chip"
      ],
      "widget_kind": "tool_toggle",
      "settings_fields": [
        {
          "id": "default_workspace_root",
          "label": "Default Workspace Root",
          "type": "text",
          "default": "",
          "help": "Durable root used when a workspace root is not provided by the runtime."
        },
        {
          "id": "max_results",
          "label": "Max Results",
          "type": "number",
          "default": 500,
          "min": 1,
          "max": 5000
        }
      ]
    },
    "tool_category": "filesystem",
    "action_type": "read",
    "risk": "low",
    "approval_policy": "allow",
    "capability_grants": [
      "file.read"
    ],
    "schema": {
      "parameters": {
        "type": "object",
        "properties": {
          "directory": {
            "type": "string"
          },
          "recursive": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    "execution": {
      "type": "global_contract",
      "contract_id": "tobkiri.service.tool.local.operation.v1",
      "provider_instance_id": "rumi_default_tools_pack.files-read",
      "operation": "rumi_default_tools_pack.files-read-operation"
    }
  }
}
