{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/task_plan.schema.json",
  "title": "Task Plan",
  "description": "Plan contract that can be redirected without executing work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "session_id",
    "steps",
    "revision",
    "approval_state",
    "source_event_ids"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "title",
          "status",
          "owner_surface",
          "handoff_owner"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "active",
              "waiting",
              "done",
              "cancelled"
            ]
          },
          "owner_surface": {
            "type": "string",
            "minLength": 1
          },
          "handoff_owner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "approval_state": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "needs_review"
      ]
    },
    "source_event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
