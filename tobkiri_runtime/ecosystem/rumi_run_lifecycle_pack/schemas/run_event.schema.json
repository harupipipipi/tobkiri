{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/run_event.schema.json",
  "title": "Run Event",
  "description": "Append-only event contract for workroom replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "session_id",
    "sequence",
    "event_type",
    "payload",
    "created_at",
    "source"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "event_type": {
      "type": "string",
      "enum": [
        "plan_created",
        "progress",
        "checkpoint",
        "interrupt",
        "redirect",
        "cancel",
        "handoff_requested",
        "handoff_result",
        "note"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "evidence_ids",
        "handoff_owner"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handoff_owner": {
          "type": "string"
        }
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "user",
        "agent",
        "system",
        "handoff_owner"
      ]
    }
  }
}
