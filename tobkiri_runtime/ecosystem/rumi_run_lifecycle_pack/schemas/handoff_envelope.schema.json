{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumi.local/schemas/handoff_envelope.schema.json",
  "title": "Handoff Envelope",
  "description": "Provider-neutral envelope for adjacent owner pack handoffs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id",
    "source_pack_id",
    "owner_pack_id",
    "target_pack_id",
    "target_capability",
    "surface",
    "reason",
    "request_ref",
    "payload_ref",
    "payload_schema_ref",
    "evidence_refs",
    "approval_required",
    "handoff_state",
    "audit_ref"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "source_pack_id": {
      "type": "string",
      "const": "rumi_run_lifecycle_pack"
    },
    "owner_pack_id": {
      "type": "string",
      "minLength": 1,
      "description": "Backward-compatible alias for target_pack_id."
    },
    "target_pack_id": {
      "type": "string",
      "enum": [
        "defaultspack",
        "rumi_default_tools_pack",
        "rumi_operations_team_pack",
        "rumi_model_catalog_pack"
      ]
    },
    "target_capability": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "type": "string",
      "enum": [
        "tool_execution",
        "agent_service_choreography",
        "browser_action",
        "desktop_action",
        "schedule_execution",
        "file_persistence",
        "metrics_collection",
        "subagent_pr_management",
        "model_routing"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "request_ref": {
      "type": "string",
      "minLength": 1
    },
    "payload_ref": {
      "type": "string",
      "minLength": 1
    },
    "payload_schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval_required": {
      "type": "boolean",
      "const": true
    },
    "handoff_state": {
      "type": "string",
      "enum": [
        "draft",
        "review_required",
        "approved_for_owner",
        "accepted_by_owner",
        "rejected_by_owner"
      ]
    },
    "audit_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
