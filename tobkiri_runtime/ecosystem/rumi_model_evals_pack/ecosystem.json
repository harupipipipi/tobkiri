  "required_network": {"allowed_domains": [], "allowed_ports": []},
  "host_execution": true,
  "provenance": {"content_hash": "sha256:73cee4d7024199cbcc312fedc7012ac3614528bcbce79522a29c59861c38df4a", "build_identity": "rumi-model-evals-pack:2.0.0", "trust_class": "local", "signature": null},
  "metadata": {
