{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.local/io.tobkiri/profile-lock.v4.schema.json",
  "title": "Tobkiri ProfileLock v4 (frozen)",
  "type": "object",
  "additionalProperties": false,
  "required": ["lock_api_version", "profile_id", "profile_revision", "catalog_revision", "security_epoch", "base", "shell", "effective_set", "plan_digest", "profile_authority_snapshot_digest", "lock_digest"],
  "properties": {
    "lock_api_version": {"const": "io.tobkiri.profile-lock.v4"},
    "profile_id": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/id"},
    "profile_revision": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"},
    "catalog_revision": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"},
    "security_epoch": {"type": "integer", "minimum": 1},
    "base": {"$ref": "#/$defs/exactBase"},
    "shell": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/exactShell"}]},
    "effective_set": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/effectiveArtifact"}},
    "plan_digest": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"},
    "profile_authority_snapshot_digest": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"},
    "lock_digest": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"}
  },
  "$defs": {
    "exactBase": {"type": "object", "additionalProperties": false, "required": ["pack_id", "artifact_digest", "definition_revision"], "properties": {"pack_id": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/id"}, "artifact_digest": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"}, "definition_revision": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"}}},
    "exactShell": {"type": "object", "additionalProperties": false, "required": ["provider_id", "pack_id", "artifact_digest", "definition_revision", "contract_id", "platform", "architecture"], "properties": {"provider_id": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/id"}, "pack_id": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/id"}, "artifact_digest": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"}, "definition_revision": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"}, "contract_id": {"const": "app.shell.v1"}, "platform": {"enum": ["macos", "windows", "linux"]}, "architecture": {"enum": ["arm64", "x86_64"]}}},
    "effectiveArtifact": {"type": "object", "additionalProperties": false, "required": ["role", "identity", "artifact_digest"], "properties": {"role": {"enum": ["base", "shell", "pack"]}, "identity": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/id"}, "artifact_digest": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"}}}
  }
}
