{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.local/io.tobkiri/external-normal-pack-catalog.v4.schema.json",
  "title": "Host-owned external Normal Pack catalog v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries", "journal", "signature"],
  "properties": {
    "version": {"const": "io.tobkiri.external-normal-pack-catalog.v4"},
    "entries": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
      "additionalProperties": {"$ref": "#/$defs/entry"}
    },
    "journal": {
      "type": "array",
      "items": {"$ref": "#/$defs/journal_event"}
    },
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "admission_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalog_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id", "display_name", "description", "version", "kind",
        "artifact_digest", "authority", "approval_policy", "capabilities",
        "dependencies", "provided_contracts", "required_contracts",
        "runtime_artifacts", "execution_boundary", "workspace_boundary",
        "network", "secrets", "legacy_ids", "legacy_operations",
        "source_provenance"
      ],
      "properties": {
        "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "display_name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "version": {"type": "string", "minLength": 1},
        "kind": {"const": "normal_sandbox"},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "authority": {"const": "host-signed-external-normal-v4"},
        "approval_policy": {"const": "explicit"},
        "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "dependencies": {"type": "object"},
        "provided_contracts": {"type": "array", "items": {"type": "object"}},
        "required_contracts": {"type": "array", "items": {"type": "object"}},
        "runtime_artifacts": {"type": "array", "items": {"type": "object"}},
        "execution_boundary": {"type": "string"},
        "workspace_boundary": {"type": "string"},
        "network": {"type": "object"},
        "secrets": {"type": "array"},
        "legacy_ids": {"type": "array", "maxItems": 0},
        "legacy_operations": {"type": "array", "maxItems": 0},
        "source_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "publisher_id", "key_id"],
          "properties": {
            "mode": {"const": "host-signed-external-normal-catalog"},
            "publisher_id": {"type": "string", "minLength": 1},
            "key_id": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "committed_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "state", "pack_id", "version_string", "artifact_digest",
        "content_digest", "publisher_id", "key_id", "catalog_record",
        "store_token", "admission_id", "root_device", "root_inode"
      ],
      "properties": {
        "version": {"const": "io.tobkiri.external-normal-pack-catalog-entry.v4"},
        "state": {"const": "committed"},
        "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "version_string": {"type": "string", "minLength": 1},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "content_digest": {"$ref": "#/$defs/digest"},
        "publisher_id": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "minLength": 1},
        "catalog_record": {"$ref": "#/$defs/catalog_record"},
        "store_token": {"type": "string", "pattern": "^[0-9a-f]{64}/[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "admission_id": {"$ref": "#/$defs/admission_id"},
        "root_device": {"type": "integer", "minimum": 0},
        "root_inode": {"type": "integer", "minimum": 0}
      }
    },
    "prepared_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "state", "pack_id", "version_string", "artifact_digest",
        "content_digest", "publisher_id", "key_id", "catalog_record",
        "store_token", "previous", "transaction_nonce"
      ],
      "properties": {
        "version": {"const": "io.tobkiri.external-normal-pack-catalog-entry.v4"},
        "state": {"const": "prepared"},
        "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "version_string": {"type": "string", "minLength": 1},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "content_digest": {"$ref": "#/$defs/digest"},
        "publisher_id": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "minLength": 1},
        "catalog_record": {"$ref": "#/$defs/catalog_record"},
        "store_token": {"type": "string", "pattern": "^[0-9a-f]{64}/[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "previous": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/committed_entry"}]},
        "transaction_nonce": {"$ref": "#/$defs/admission_id"}
      }
    },
    "entry": {"oneOf": [{"$ref": "#/$defs/committed_entry"}, {"$ref": "#/$defs/prepared_entry"}]},
    "journal_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence", "event_type", "admission_id", "pack_id",
        "artifact_digest", "content_digest", "previous_event_digest",
        "event_digest"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "event_type": {"const": "external_normal_pack_admitted"},
        "admission_id": {"$ref": "#/$defs/admission_id"},
        "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "content_digest": {"$ref": "#/$defs/digest"},
        "previous_event_digest": {"$ref": "#/$defs/digest"},
        "event_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
