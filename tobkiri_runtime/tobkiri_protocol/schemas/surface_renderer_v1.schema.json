{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "tobkiri.ui.surface-renderer.v1"
    },
    "api_version": {
      "const": "1.0.0"
    },
    "implementation": {
      "enum": [
        "semantic_standard",
        "semantic_compact"
      ]
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "content",
          "problem",
          "notice",
          "progress",
          "resource_input",
          "choice",
          "form",
          "confirmation",
          "collection",
          "detail"
        ]
      }
    },
    "ttl_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000
    }
  },
  "required": [
    "version",
    "api_version",
    "implementation",
    "patterns",
    "ttl_ms"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tobkiri.ui.surface-renderer.v1"
}
