{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.local/io.tobkiri/surface-template.v1.schema.json",
  "title": "Tobkiri Surface Template v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["surface_api_version", "template_id", "version", "binds", "input", "outcomes"],
  "properties": {
    "surface_api_version": {"const": "io.tobkiri.surface-template.v1"},
    "template_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$",
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": {"type": "string", "maxLength": 2000},
    "binds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "operation_id"],
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "contract_revision_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "input_schema_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "output_schema_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "error_schema_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "progress_schema_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "input": {"$ref": "#/$defs/input"},
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "success": {"$ref": "#/$defs/outcome"},
        "error": {"$ref": "#/$defs/outcome"},
        "progress": {"$ref": "#/$defs/outcome"},
        "notice": {"$ref": "#/$defs/outcome"}
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/action"}
    },
    "required_patterns": {
      "type": "array",
      "items": {"$ref": "#/$defs/pattern"},
      "uniqueItems": true,
      "maxItems": 16
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^io\\.tobkiri\\.[a-z0-9]+(?:[._/-][a-z0-9]+)*$",
        "maxLength": 160
      },
      "uniqueItems": true,
      "maxItems": 32
    },
    "security": {"$ref": "#/$defs/security"}
  },
  "$defs": {
    "pattern": {
      "type": "string",
      "enum": [
        "content",
        "problem",
        "notice",
        "progress",
        "resource_input",
        "choice",
        "form",
        "confirmation",
        "collection",
        "detail"
      ]
    },
    "selector": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^\\$(?:(?:[A-Za-z][A-Za-z0-9_]*)|(?:\\.[A-Za-z][A-Za-z0-9_]*)|(?:\\[(?:0|[1-9][0-9]*)\\])){1,16}$|^\\$$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern"],
      "properties": {
        "pattern": {"$ref": "#/$defs/pattern"},
        "accepts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resource_kinds": {
              "type": "array",
              "items": {"enum": ["file", "image", "conversation", "artifact", "text", "uri"]},
              "uniqueItems": true,
              "maxItems": 8
            },
            "media_types": {
              "type": "array",
              "items": {"type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+*-]+$", "maxLength": 127},
              "uniqueItems": true,
              "maxItems": 32
            },
            "multiple": {"type": "boolean"}
          }
        },
        "resource_kind": {"enum": ["file", "image", "conversation", "artifact", "text", "uri"]},
        "effect": {"enum": ["attach", "inspect", "import", "reference", "compare", "open", "invoke"]},
        "bind_to": {"$ref": "#/$defs/selector"},
        "options": {"$ref": "#/$defs/selector"},
        "label": {"type": "string", "maxLength": 500}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern"],
      "properties": {
        "pattern": {"$ref": "#/$defs/pattern"},
        "data": {"$ref": "#/$defs/selector"},
        "items": {"$ref": "#/$defs/selector"},
        "code": {"$ref": "#/$defs/selector"},
        "message": {"$ref": "#/$defs/selector"},
        "current": {"$ref": "#/$defs/selector"},
        "total": {"$ref": "#/$defs/selector"},
        "level": {"$ref": "#/$defs/selector"},
        "dedupe_key": {"$ref": "#/$defs/selector"},
        "title": {"$ref": "#/$defs/selector"},
        "details": {"$ref": "#/$defs/selector"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "operation_id", "payload_binding"],
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "payload_binding": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "additionalProperties": {"$ref": "#/$defs/selector"}
        },
        "label": {"type": "string", "maxLength": 200},
        "sensitive": {"type": "boolean"}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {"enum": ["ordinary", "trusted", "sensitive"]},
        "requires_trusted_renderer": {"type": "boolean"}
      }
    }
  }
}
