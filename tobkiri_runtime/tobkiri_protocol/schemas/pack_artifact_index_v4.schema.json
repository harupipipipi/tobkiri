{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.local/io.tobkiri/pack-artifact-index.v4.schema.json",
  "title": "Tobkiri Pack artifact index v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["index_api_version", "pack_id", "source_identity", "artifacts", "artifact_set_digest", "integrity_seal"],
  "properties": {
    "index_api_version": {"const": "io.tobkiri.pack-artifact-index.v4"},
    "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "source_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "role": {"enum": ["canonical_manifest", "contract_catalog", "runtime", "asset", "schema", "sidecar"]}
        }
      }
    },
    "artifact_set_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "integrity_seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signed_digest"],
      "properties": {
        "algorithm": {"const": "sha256-canonical-v1"},
        "signed_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
