{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.local/io.tobkiri/request-envelope.v1.schema.json",
  "title": "Tobkiri host-generated request envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "request_id", "trace_id", "request_digest", "caller_principal", "target_principal", "profile_id", "profile_revision", "plan_digest", "activation_digest", "security_epoch", "contract_id", "schema_digest", "operation_id", "lease_reference", "payload"],
  "properties": {
    "protocol": {"const": "io.tobkiri.request-envelope.v1"},
    "request_id": {"type": "string", "pattern": "^req:[a-z0-9][a-z0-9._-]{7,127}$"},
    "trace_id": {"type": "string", "pattern": "^trace:[a-z0-9][a-z0-9._-]{7,127}$"},
    "correlation_id": {"type": "string", "pattern": "^corr:[a-z0-9][a-z0-9._-]{7,127}$"},
    "causation_id": {"type": "string", "pattern": "^req:[a-z0-9][a-z0-9._-]{7,127}$"},
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "caller_principal": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/function-principal.v1.schema.json"},
    "target_principal": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/function-principal.v1.schema.json"},
    "delegation_chain": {"type": "array", "items": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/function-principal.v1.schema.json"}, "maxItems": 4},
    "caller_domain_id": {"type": "string", "pattern": "^domain:[a-z0-9][a-z0-9._-]{7,127}$"},
    "target_domain_id": {"type": "string", "pattern": "^domain:[a-z0-9][a-z0-9._-]{7,127}$"},
    "caller_boot_epoch": {"type": "integer", "minimum": 0},
    "target_boot_epoch": {"type": "integer", "minimum": 0},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "profile_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile_authority_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "activation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "security_epoch": {"type": "integer", "minimum": 0},
    "contract_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"},
    "schema_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "lease_reference": {"type": "string", "pattern": "^lease:[a-z0-9][a-z0-9._-]{7,127}$"},
    "payload": {},
    "resource_references": {"type": "array", "items": {"type": "string", "pattern": "^handle:[a-z0-9][a-z0-9._-]{7,127}$"}, "uniqueItems": true},
    "deadline_remaining_ms": {"type": "integer", "minimum": 1}
  }
}
