{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.local/io.tobkiri/saved-workflow-admission.v1.schema.json",
  "title": "Saved Workflow owner admission (identity, not authority)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "turn_id",
    "conversation_id",
    "run_id",
    "definition_id",
    "activation_id",
    "input_digest",
    "revision_digest",
    "policy_digest",
    "plan_digest",
    "activation_digest",
    "admission_api_version",
    "security_epoch",
    "workflow_principal_ids",
    "owner_principal_id",
    "owner_session_id"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "turn_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "definition_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "activation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "activation_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "admission_api_version": {
      "const": "io.tobkiri.saved-workflow-admission.v1"
    },
    "security_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "workflow_principal_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "owner_principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "owner_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  }
}
