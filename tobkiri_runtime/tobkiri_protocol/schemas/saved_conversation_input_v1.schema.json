{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tobkiri.dev/schemas/saved_conversation_input_v1.schema.json",
  "title": "Saved conversation initial input",
  "description": "Initial saved_complete input only. Resume state is guest-root owned and is never accepted by this external input contract. Text is limited to 60 KiB; up to two PNG, JPEG, WebP, or GIF data URLs are accepted within a 3 MiB encoded input budget enforced separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request"
  ],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_id",
        "conversation_id",
        "conversation_revision",
        "content"
      ],
      "properties": {
        "turn_id": {
          "$ref": "#/$defs/identifier"
        },
        "conversation_id": {
          "$ref": "#/$defs/identifier"
        },
        "conversation_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 61440,
              "pattern": "\\S"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "prefixItems": [
                {
                  "$ref": "#/$defs/text_block"
                }
              ],
              "items": {
                "$ref": "#/$defs/image_block"
              }
            }
          ]
        },
        "tool_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "auto",
                "manual",
                "none"
              ]
            },
            "scope": {
              "enum": [
                "turn",
                "conversation"
              ]
            },
            "must_use": {
              "type": "boolean"
            },
            "include": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9]",
                    "not": {
                      "pattern": "[^A-Za-z0-9._:/-]"
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "tool",
                          "service"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[A-Za-z0-9]",
                        "not": {
                          "pattern": "[^A-Za-z0-9._:/-]"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "exclude": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9]",
                    "not": {
                      "pattern": "[^A-Za-z0-9._:/-]"
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "tool",
                          "service"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[A-Za-z0-9]",
                        "not": {
                          "pattern": "[^A-Za-z0-9._:/-]"
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "none"
                  }
                }
              },
              "then": {
                "properties": {
                  "include": {
                    "maxItems": 0
                  },
                  "must_use": {
                    "const": false
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "text_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 61440,
          "pattern": "\\S"
        }
      }
    },
    "image_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "image_url"
      ],
      "properties": {
        "type": {
          "const": "image_url"
        },
        "image_url": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1398127,
              "pattern": "^data:image/(png|jpeg|webp|gif);base64,[A-Za-z0-9+/]+={0,2}$"
            }
          }
        }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9]",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    }
  }
}
