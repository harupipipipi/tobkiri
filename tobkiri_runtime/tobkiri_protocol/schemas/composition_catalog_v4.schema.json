{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.local/io.tobkiri/composition-catalog.v4.schema.json",
  "title": "Tobkiri verified composition catalog v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_api_version", "catalog_revision", "bases", "shells", "packs", "integrity"],
  "properties": {
    "catalog_api_version": {"const": "io.tobkiri.composition-catalog.v4"},
    "catalog_revision": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"},
    "bases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["definition", "relative_path", "approval_state"],
        "properties": {
          "definition": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/base-definition.v4.schema.json"},
          "relative_path": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/composition-catalog.v4.schema.json#/$defs/relativePath"},
          "approval_state": {"enum": ["verified", "unapproved", "revoked"]}
        }
      }
    },
    "shells": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["definition", "approval_state"],
        "properties": {
          "definition": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/shell-definition.v4.schema.json"},
          "approval_state": {"enum": ["verified", "unapproved", "revoked"]}
        }
      }
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pack_id", "artifact_digest", "relative_path", "approval_state"],
        "properties": {
          "pack_id": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/id"},
          "artifact_digest": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"},
          "relative_path": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/composition-catalog.v4.schema.json#/$defs/relativePath"},
          "approval_state": {"enum": ["verified", "unapproved", "revoked"]}
        }
      }
    },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_digest", "signature"],
      "properties": {
        "payload_digest": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"},
        "signature": {
          "type": "object", "additionalProperties": false,
          "required": ["algorithm", "key_id", "value"],
          "properties": {
            "algorithm": {"const": "ed25519"},
            "key_id": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/id"},
            "value": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  }
}
