{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.local/io.tobkiri/executable-catalog.v4.schema.json",
  "title": "Tobkiri executable catalog v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_api_version", "pack_id", "source_identity", "variants", "catalog_digest"],
  "properties": {
    "catalog_api_version": {"const": "io.tobkiri.executable-catalog.v4"},
    "pack_id": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/id"},
    "source_identity": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"},
    "materialization_catalog_digest": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"},
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant_id", "function_id", "implementation_path", "implementation_digest", "execution_kind", "platform", "architecture", "runtime_abi", "backend", "materialization_mode", "execution_domain_profile", "operations"],
        "properties": {
          "variant_id": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/id"},
          "function_id": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/id"},
          "implementation_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "implementation_digest": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"},
          "execution_kind": {"enum": ["wasm", "pack_vm", "host_extension", "remote"]},
          "platform": {"type": "string", "minLength": 1},
          "architecture": {"type": "string", "minLength": 1},
          "runtime_abi": {"type": "string", "minLength": 1},
          "backend": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/id"},
          "materialization_mode": {"enum": ["eager", "continuous", "on_demand", "event_wake"]},
          "execution_domain_profile": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/id"},
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["contract_id", "contract_version", "revision_digest", "operation_id", "input_schema", "output_schema", "error_schema", "effect_class", "timeout_default_ms", "timeout_hard_max_ms", "idempotency"],
              "properties": {
                "contract_id": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/contractId"},
                "contract_version": {"type": "string", "minLength": 1},
                "revision_digest": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"},
                "operation_id": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/id"},
                "input_schema": {"type": "object"},
                "output_schema": {"type": "object"},
                "error_schema": {"type": "object"},
                "effect_class": {"enum": ["pure", "read", "write", "external_effect", "privileged"]},
                "timeout_default_ms": {"type": "integer", "minimum": 1},
                "timeout_hard_max_ms": {"type": "integer", "minimum": 1},
                "idempotency": {"enum": ["none", "keyed", "replayable"]}
              }
            }
          }
        }
      }
    },
    "catalog_digest": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/digest"}
  }
}
