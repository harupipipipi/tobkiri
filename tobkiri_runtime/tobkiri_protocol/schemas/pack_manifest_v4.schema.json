{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.local/io.tobkiri/pack-manifest.v4.schema.json",
  "title": "Tobkiri Pack Manifest v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_api_version", "pack", "functions", "contracts", "artifacts", "requirements", "operation_catalog", "provider_catalog", "integrity", "provenance", "migration"],
  "properties": {
    "pack_api_version": {"const": "io.tobkiri.pack.v4"},
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "artifact_digest", "display_name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
        "kind": {"enum": ["normal_sandbox", "host_extension", "base", "shell", "application"]},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "display_name": {"type": "string", "minLength": 1},
        "publisher_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "signing_lineage_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "implementation_digest", "contract_revision_digest", "operations", "role"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "implementation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "contract_revision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "operations": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"}, "uniqueItems": true},
          "role": {"enum": ["pure", "vendor_semantic", "brokered", "host_capability_provider"]},
          "isolation": {"enum": ["wasm_component", "pack_vm", "dedicated_process", "remote"]}
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_id", "revision_digest", "operations"],
        "properties": {
          "contract_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"},
          "revision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "operations": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"}, "uniqueItems": true}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest", "kind"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "kind": {"enum": ["executable", "schema", "asset", "variant", "sidecar", "ui.contribution"]},
          "platform": {"type": "string"},
          "entrypoint": {"type": "string", "minLength": 1},
          "entrypoint_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "argv": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_dependencies", "contract_dependencies", "capabilities", "network", "secrets", "execution_boundary", "approval_policy", "workspace_boundary"],
      "properties": {
        "pack_dependencies": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "contract_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contract_id", "version_range", "cardinality", "optional"],
            "properties": {
              "contract_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"},
              "version_range": {"type": "string", "minLength": 1},
              "cardinality": {"enum": ["one", "many", "keyed", "chain", "fanout", "optional"]},
              "optional": {"type": "boolean"},
              "instance_key": {"type": "string", "minLength": 1}
            }
          }
        },
        "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "network": {"type": "object"},
        "secrets": {"type": "array", "items": {}, "uniqueItems": true},
        "execution_boundary": {"enum": ["sandbox", "host_brokered", "declarative_only", "remote"]},
        "approval_policy": {"enum": ["none", "capability_gated", "always"]},
        "workspace_boundary": {"enum": ["pack_local", "workspace_brokered", "host_brokered", "none"]}
      }
    },
    "operation_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "owner", "source_kind", "effect_ceiling"],
        "properties": {
          "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "owner": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "contract_reference": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"},
          "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "source_kind": {"enum": ["canonical_v4_contract", "v3_contract", "legacy_component", "legacy_connectivity"]},
          "effect_ceiling": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "provider_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "owner", "contract_reference", "operations"],
        "properties": {
          "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "owner": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "contract_reference": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"},
          "operations": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"}, "uniqueItems": true}
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_identity", "artifact_set_digest", "contract_catalog_digest"],
      "properties": {
        "source_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifact_set_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "contract_catalog_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "provenance": {"$ref": "https://schemas.tobkiri.local/io.tobkiri/common.v1.schema.json#/$defs/provenance"},
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "legacy_ids", "removal_wave", "sunset_at"],
      "properties": {
        "compatibility": {"enum": ["none", "read_only"]},
        "legacy_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "removal_wave": {"type": "integer", "minimum": 0},
        "sunset_at": {"type": "string", "format": "date"}
      }
    }
  }
}
