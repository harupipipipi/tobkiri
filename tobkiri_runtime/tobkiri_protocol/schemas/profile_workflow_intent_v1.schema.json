{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tobkiri.local/io.tobkiri/profile-workflow-intent.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_intent_api_version",
    "steps"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "request"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "when": {
            "type": "string",
            "maxLength": 512
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400000
          },
          "retry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_attempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "backoff_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400000
              }
            }
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contract_id",
              "contract_revision_digest",
              "operation_id",
              "function_id",
              "input"
            ],
            "properties": {
              "contract_id": {
                "type": "string"
              },
              "contract_revision_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "operation_id": {
                "type": "string"
              },
              "input": {
                "type": "object"
              },
              "function_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "workflow_intent_api_version": {
      "const": "io.tobkiri.profile-workflow-intent.v1"
    }
  },
  "title": "Selected Workflow source intent with exact Function identity"
}
