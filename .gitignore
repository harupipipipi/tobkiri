# === git root (rumi_ai/) 用 ===
/*
!.gitignore
!/.github/
!/AGENTS.md
!/justfile
!/tobkiri_runtime/
!/tobkiri_launcher/
!/pack-shell/
!/tobkiri_mobile/
!/scripts/
!/scripts/support/
!/scripts/support/collect_managed_runtime_bundle.py
!/tests/

# 整理退避用ディレクトリは Git 管理しない
/others/

# === 共通の不要ファイル ===
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.DS_Store
*.exe
*.zip
*.bak
*.bak.*
.env
.env.local
.env.*
oauth.env
apikey.env
sample.env.local
.desktop_api_token
.vscode/
node_modules/
dist/
**/.desktop_api_token

# フロントエンドビルド成果物（配布に必要なので除外しない）
!tobkiri_runtime/core_runtime/core_pack/*/web/

# === tobkiri_runtime/ 内の不要ファイル ===
chats/
userdata/
tenpu/
debug.txt
erroer_memo.txt
flow.iranai
.backups/
.backup_dead_code_removal/
deploy.py
**/target/
tobkiri_runtime/user_data/
tobkiri_runtime/bundled/
tobkiri_runtime/python-runtime/
tobkiri_runtime/ecosystem/defaultspack/user_data/
tobkiri_runtime/ecosystem/rumi_default_tools_pack/user_data/

# Generated by defaultspack/webapp `npm run build` from webapp/public.
tobkiri_runtime/ecosystem/defaultspack/ui/mediapipe/
tobkiri_runtime/ecosystem/defaultspack/ui/models/hand_landmarker.task
.test-logs/
